/-- A tagged BLAKE3 compression invocation `(contextKey, domainFlags, payload)`. -/
structure KeyedInput where
  contextKey : Digest
  domainFlags : UInt32
  payload : ByteArray
  deriving DecidableEq

/-- Plain (unkeyed, `v5`) BLAKE3 invocation input. -/
def plainInput (payload : ByteArray) : KeyedInput :=
  ⟨Blake3.iv, 0, payload⟩

/-- Domain-separated Merkle leaf invocation input. -/
def leafInput (sep : DomainSep) (payload : ByteArray) : KeyedInput :=
  ⟨sep.leafKey, Blake3.flagDeriveKeyMaterial, payload⟩

/-- Domain-separated Merkle 2-to-1 internal-node invocation input (64 bytes, 1 block). -/
def nodeInput (sep : DomainSep) (left right : Digest) : KeyedInput :=
  ⟨sep.compressKey, Blake3.flagDeriveKeyMaterial, left.toBytes ++ right.toBytes⟩

/-- Domain-separated 48-byte XOF Merkle internal-node invocation input (96 bytes, 2 blocks). -/
def node48Input (sep : DomainSep) (left right : Digest48) : KeyedInput :=
  ⟨sep.compressKey, Blake3.flagDeriveKeyMaterial, left.toBytes ++ right.toBytes⟩

/-- Domain-separated Fiat–Shamir transcript invocation input. -/
def transcriptInput (sep : DomainSep) (input : ByteArray) : KeyedInput :=
  ⟨sep.transcriptKey, Blake3.flagDeriveKeyMaterial, input⟩

/-! ## Disjointness of all BLAKE3 `derive_key` invocation domains -/

/-- A Merkle leaf invocation never collides with a Merkle internal-node invocation. -/
theorem leafInput_ne_nodeInput (sep : DomainSep) (payload : ByteArray) (left right : Digest) :
    sep.leafInput payload ≠ sep.nodeInput left right :=
  fun h => sep.leafKey_ne_compressKey (congrArg KeyedInput.contextKey h)

/-- A Merkle leaf invocation never collides with a 48-byte internal-node invocation. -/
theorem leafInput_ne_node48Input (sep : DomainSep) (payload : ByteArray)
    (left right : Digest48) :
    sep.leafInput payload ≠ sep.node48Input left right :=
  fun h => sep.leafKey_ne_compressKey (congrArg KeyedInput.contextKey h)

/-- A Merkle leaf invocation never collides with a Fiat–Shamir transcript invocation. -/
theorem leafInput_ne_transcriptInput (sep : DomainSep) (payload input : ByteArray) :
    sep.leafInput payload ≠ sep.transcriptInput input :=
  fun h => sep.leafKey_ne_transcriptKey (congrArg KeyedInput.contextKey h)

/-- A Merkle internal-node invocation never collides with a Fiat–Shamir transcript invocation. -/
theorem nodeInput_ne_transcriptInput (sep : DomainSep) (left right : Digest) (input : ByteArray) :
    sep.nodeInput left right ≠ sep.transcriptInput input :=
  fun h => sep.compressKey_ne_transcriptKey (congrArg KeyedInput.contextKey h)

/-- Every `derive_key` domain is unconditionally disjoint from plain (unkeyed) BLAKE3
via the `flagDeriveKeyMaterial` (`64 ≠ 0`) compression flag bit. -/
theorem leafInput_ne_plainInput (sep : DomainSep) (p₁ p₂ : ByteArray) :
    sep.leafInput p₁ ≠ plainInput p₂ := by
  intro h
  have hf := congrArg KeyedInput.domainFlags h
  simp [leafInput, plainInput, Blake3.flagDeriveKeyMaterial] at hf

theorem nodeInput_ne_plainInput (sep : DomainSep) (left right : Digest) (p : ByteArray) :
    sep.nodeInput left right ≠ plainInput p := by
  intro h
  have hf := congrArg KeyedInput.domainFlags h
  simp [nodeInput, plainInput, Blake3.flagDeriveKeyMaterial] at hf

theorem transcriptInput_ne_plainInput (sep : DomainSep) (p₁ p₂ : ByteArray) :
    sep.transcriptInput p₁ ≠ plainInput p₂ := by
  intro h
  have hf := congrArg KeyedInput.domainFlags h
  simp [transcriptInput, plainInput, Blake3.flagDeriveKeyMaterial] at hf

/-! ## Injectivity of canonical encodings -/

private theorem uint32_toNat_shift_byte (w k : UInt32) (hk : k.toNat < 32) :
    ((w >>> k).toUInt8).toNat = (w.toNat / 2 ^ k.toNat) % 256 := by
  have hmod : k.toNat % 32 = k.toNat := Nat.mod_eq_of_lt hk
  rw [UInt32.toNat_toUInt8, UInt32.toNat_shiftRight, hmod, Nat.shiftRight_eq_div_pow]

private theorem uint32_eq_of_bytes {a b : UInt32}
    (h0 : a.toUInt8 = b.toUInt8)
    (h1 : (a >>> 8).toUInt8 = (b >>> 8).toUInt8)
    (h2 : (a >>> 16).toUInt8 = (b >>> 16).toUInt8)
    (h3 : (a >>> 24).toUInt8 = (b >>> 24).toUInt8) : a = b := by
  have e0 : a.toNat % 256 = b.toNat % 256 := by
    have := congrArg UInt8.toNat h0
    simpa [UInt32.toNat_toUInt8] using this
  have e1 : (a.toNat / 256) % 256 = (b.toNat / 256) % 256 := by
    have := congrArg UInt8.toNat h1
    rw [uint32_toNat_shift_byte a 8 (by decide), uint32_toNat_shift_byte b 8 (by decide)] at this
    exact this
  have e2 : (a.toNat / 65536) % 256 = (b.toNat / 65536) % 256 := by
    have := congrArg UInt8.toNat h2
    rw [uint32_toNat_shift_byte a 16 (by decide), uint32_toNat_shift_byte b 16 (by decide)] at this
    exact this
  have e3 : (a.toNat / 16777216) % 256 = (b.toNat / 16777216) % 256 := by
    have := congrArg UInt8.toNat h3
    rw [uint32_toNat_shift_byte a 24 (by decide), uint32_toNat_shift_byte b 24 (by decide)] at this
    exact this
  have ha := a.toNat_lt
  have hb := b.toNat_lt
  exact UInt32.toNat_inj.mp (by omega)

private theorem uint64_toNat_shift_byte (w k : UInt64) (hk : k.toNat < 64) :
    ((w >>> k).toUInt8).toNat = (w.toNat / 2 ^ k.toNat) % 256 := by
  have hmod : k.toNat % 64 = k.toNat := Nat.mod_eq_of_lt hk
  rw [UInt64.toNat_toUInt8, UInt64.toNat_shiftRight, hmod, Nat.shiftRight_eq_div_pow]

private theorem uint64_eq_of_bytes {a b : UInt64}
    (h0 : a.toUInt8 = b.toUInt8)
    (h1 : (a >>> 8).toUInt8 = (b >>> 8).toUInt8)
    (h2 : (a >>> 16).toUInt8 = (b >>> 16).toUInt8)
    (h3 : (a >>> 24).toUInt8 = (b >>> 24).toUInt8)
    (h4 : (a >>> 32).toUInt8 = (b >>> 32).toUInt8)
    (h5 : (a >>> 40).toUInt8 = (b >>> 40).toUInt8)
    (h6 : (a >>> 48).toUInt8 = (b >>> 48).toUInt8)
    (h7 : (a >>> 56).toUInt8 = (b >>> 56).toUInt8) : a = b := by
  have e0 : a.toNat % 256 = b.toNat % 256 := by
    have := congrArg UInt8.toNat h0
    simpa [UInt64.toNat_toUInt8] using this
  have e1 : (a.toNat / 2 ^ 8) % 256 = (b.toNat / 2 ^ 8) % 256 := by
    have := congrArg UInt8.toNat h1
    rw [uint64_toNat_shift_byte a 8 (by decide), uint64_toNat_shift_byte b 8 (by decide)] at this
    exact this
  have e2 : (a.toNat / 2 ^ 16) % 256 = (b.toNat / 2 ^ 16) % 256 := by
    have := congrArg UInt8.toNat h2
    rw [uint64_toNat_shift_byte a 16 (by decide), uint64_toNat_shift_byte b 16 (by decide)] at this
    exact this
  have e3 : (a.toNat / 2 ^ 24) % 256 = (b.toNat / 2 ^ 24) % 256 := by
    have := congrArg UInt8.toNat h3
    rw [uint64_toNat_shift_byte a 24 (by decide), uint64_toNat_shift_byte b 24 (by decide)] at this
    exact this
  have e4 : (a.toNat / 2 ^ 32) % 256 = (b.toNat / 2 ^ 32) % 256 := by
    have := congrArg UInt8.toNat h4
    rw [uint64_toNat_shift_byte a 32 (by decide), uint64_toNat_shift_byte b 32 (by decide)] at this
    exact this
  have e5 : (a.toNat / 2 ^ 40) % 256 = (b.toNat / 2 ^ 40) % 256 := by
    have := congrArg UInt8.toNat h5
    rw [uint64_toNat_shift_byte a 40 (by decide), uint64_toNat_shift_byte b 40 (by decide)] at this
    exact this
  have e6 : (a.toNat / 2 ^ 48) % 256 = (b.toNat / 2 ^ 48) % 256 := by
    have := congrArg UInt8.toNat h6
    rw [uint64_toNat_shift_byte a 48 (by decide), uint64_toNat_shift_byte b 48 (by decide)] at this
    exact this
  have e7 : (a.toNat / 2 ^ 56) % 256 = (b.toNat / 2 ^ 56) % 256 := by
    have := congrArg UInt8.toNat h7
    rw [uint64_toNat_shift_byte a 56 (by decide), uint64_toNat_shift_byte b 56 (by decide)] at this
    exact this
  have ha := a.toNat_lt
  have hb := b.toNat_lt
  exact UInt64.toNat_inj.mp (by omega)

private def word32Bytes (w : UInt32) : List UInt8 :=
  [w.toUInt8, (w >>> 8).toUInt8, (w >>> 16).toUInt8, (w >>> 24).toUInt8]

private def goldilocksBytes (a : Goldilocks) : List UInt8 :=
  let w := a.val
  [w.toUInt8, (w >>> 8).toUInt8, (w >>> 16).toUInt8, (w >>> 24).toUInt8,
    (w >>> 32).toUInt8, (w >>> 40).toUInt8, (w >>> 48).toUInt8, (w >>> 56).toUInt8]

private theorem pushWord32_toList (bytes : ByteArray) (w : UInt32) :
    (LittleEndian.pushWord32 bytes w).data.toList = bytes.data.toList ++ word32Bytes w := by
  simp [LittleEndian.pushWord32, word32Bytes, ByteArray.push, List.append_assoc]

private theorem pushBytes_toList (bytes : ByteArray) (a : Goldilocks) :
    (a.pushBytes bytes).data.toList = bytes.data.toList ++ goldilocksBytes a := by
  simp [Goldilocks.pushBytes, goldilocksBytes, ByteArray.push, List.append_assoc]

private theorem word32Bytes_injective {a b : UInt32} (h : word32Bytes a = word32Bytes b) :
    a = b := by
  simp only [word32Bytes, List.cons.injEq, and_true] at h
  exact uint32_eq_of_bytes h.1 h.2.1 h.2.2.1 h.2.2.2

private theorem goldilocksBytes_injective {a b : Goldilocks}
    (h : goldilocksBytes a = goldilocksBytes b) : a = b := by
  simp only [goldilocksBytes, List.cons.injEq, and_true] at h
  exact Goldilocks.ext (uint64_eq_of_bytes h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1
    h.2.2.2.2.2.1 h.2.2.2.2.2.2.1 h.2.2.2.2.2.2.2)

private theorem flatMap_fixed_pos_injective {α β : Type} {f : α → List β} {k : Nat} (hk : 0 < k)
    (hlen : ∀ x, (f x).length = k) (hinj : ∀ x y, f x = f y → x = y) :
    ∀ {l₁ l₂ : List α}, l₁.flatMap f = l₂.flatMap f → l₁ = l₂
  | [], [], _ => rfl
  | [], b :: l₂, h => by
    have := congrArg List.length h
    simp [hlen] at this
    omega
  | a :: l₁, [], h => by
    have := congrArg List.length h
    simp [hlen] at this
    omega
  | a :: l₁, b :: l₂, h => by
    simp only [List.flatMap_cons] at h
    have hab : f a = f b ∧ l₁.flatMap f = l₂.flatMap f :=
      List.append_inj h (by rw [hlen, hlen])
    rw [hinj a b hab.1, flatMap_fixed_pos_injective hk hlen hinj hab.2]

private theorem foldl_pushWord32_toList (acc : ByteArray) (ws : List UInt32) :
    (ws.foldl LittleEndian.pushWord32 acc).data.toList =
      acc.data.toList ++ ws.flatMap word32Bytes := by
  induction ws generalizing acc with
  | nil => simp
  | cons w ws ih =>
    simp only [List.foldl_cons, List.flatMap_cons, ih, pushWord32_toList, List.append_assoc]

private theorem digest_toBytes_toList (d : Digest) :
    d.toBytes.data.toList = [d.w0, d.w1, d.w2, d.w3, d.w4, d.w5, d.w6, d.w7].flatMap word32Bytes := by
  unfold Digest.toBytes
  rw [foldl_pushWord32_toList]
  rfl

theorem digest_toBytes_length (d : Digest) : d.toBytes.data.toList.length = 32 := by
  rw [digest_toBytes_toList]
  simp [word32Bytes]

/-- `Digest.toBytes` is injective. -/
theorem digest_toBytes_injective {d₁ d₂ : Digest} (h : d₁.toBytes = d₂.toBytes) : d₁ = d₂ := by
  have hlist : d₁.toBytes.data.toList = d₂.toBytes.data.toList :=
    congrArg (fun b => b.data.toList) h
  rw [digest_toBytes_toList, digest_toBytes_toList] at hlist
  have hws := flatMap_fixed_pos_injective (k := 4) (by decide)
    (fun _ => rfl) (fun _ _ => word32Bytes_injective) hlist
  cases d₁; cases d₂
  simp only [List.cons.injEq, and_true] at hws
  obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ := hws
  rfl

private theorem digest48_toBytes_toList (d : Digest48) :
    d.toBytes.data.toList =
      [d.w0, d.w1, d.w2, d.w3, d.w4, d.w5, d.w6, d.w7, d.w8, d.w9, d.w10, d.w11].flatMap
        word32Bytes := by
  unfold Digest48.toBytes
  rw [foldl_pushWord32_toList]
  rfl

theorem digest48_toBytes_length (d : Digest48) : d.toBytes.data.toList.length = 48 := by
  rw [digest48_toBytes_toList]
  simp [word32Bytes]

/-- `Digest48.toBytes` is injective. -/
theorem digest48_toBytes_injective {d₁ d₂ : Digest48} (h : d₁.toBytes = d₂.toBytes) :
    d₁ = d₂ := by
  have hlist : d₁.toBytes.data.toList = d₂.toBytes.data.toList :=
    congrArg (fun b => b.data.toList) h
  rw [digest48_toBytes_toList, digest48_toBytes_toList] at hlist
  have hws := flatMap_fixed_pos_injective (k := 4) (by decide)
    (fun _ => rfl) (fun _ _ => word32Bytes_injective) hlist
  cases d₁; cases d₂
  simp only [List.cons.injEq, and_true] at hws
  obtain ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩ := hws
  rfl

/-- Concatenating two 32-byte digests is injective in both children. -/
theorem pairBytes_injective {l₁ r₁ l₂ r₂ : Digest}
    (h : l₁.toBytes ++ r₁.toBytes = l₂.toBytes ++ r₂.toBytes) : l₁ = l₂ ∧ r₁ = r₂ := by
  have hlist : (l₁.toBytes ++ r₁.toBytes).data.toList = (l₂.toBytes ++ r₂.toBytes).data.toList :=
    congrArg (fun b => b.data.toList) h
  rw [ByteArray.data_append, ByteArray.data_append, Array.toList_append, Array.toList_append] at hlist
  have hlr := List.append_inj hlist (by rw [digest_toBytes_length, digest_toBytes_length])
  refine ⟨digest_toBytes_injective ?_, digest_toBytes_injective ?_⟩
  · cases h1 : l₁.toBytes; cases h2 : l₂.toBytes
    rw [h1, h2] at hlr
    exact congrArg ByteArray.mk (Array.toList_inj.mp hlr.1)
  · cases h1 : r₁.toBytes; cases h2 : r₂.toBytes
    rw [h1, h2] at hlr
    exact congrArg ByteArray.mk (Array.toList_inj.mp hlr.2)

/-- Concatenating two 48-byte digests is injective in both children. -/
theorem pair48Bytes_injective {l₁ r₁ l₂ r₂ : Digest48}
    (h : l₁.toBytes ++ r₁.toBytes = l₂.toBytes ++ r₂.toBytes) : l₁ = l₂ ∧ r₁ = r₂ := by
  have hlist : (l₁.toBytes ++ r₁.toBytes).data.toList = (l₂.toBytes ++ r₂.toBytes).data.toList :=
    congrArg (fun b => b.data.toList) h
  rw [ByteArray.data_append, ByteArray.data_append, Array.toList_append, Array.toList_append] at hlist
  have hlr := List.append_inj hlist (by rw [digest48_toBytes_length, digest48_toBytes_length])
  refine ⟨digest48_toBytes_injective ?_, digest48_toBytes_injective ?_⟩
  · cases h1 : l₁.toBytes; cases h2 : l₂.toBytes
    rw [h1, h2] at hlr
    exact congrArg ByteArray.mk (Array.toList_inj.mp hlr.1)
  · cases h1 : r₁.toBytes; cases h2 : r₂.toBytes
    rw [h1, h2] at hlr
    exact congrArg ByteArray.mk (Array.toList_inj.mp hlr.2)

/-- `nodeInput` is injective in both child digests. -/
theorem nodeInput_injective (sep : DomainSep) {l₁ r₁ l₂ r₂ : Digest}
    (h : sep.nodeInput l₁ r₁ = sep.nodeInput l₂ r₂) : l₁ = l₂ ∧ r₁ = r₂ := by
  have hp : l₁.toBytes ++ r₁.toBytes = l₂.toBytes ++ r₂.toBytes := by
    simpa [nodeInput] using congrArg KeyedInput.payload h
  exact pairBytes_injective hp

/-- `node48Input` is injective in both 48-byte child digests. -/
theorem node48Input_injective (sep : DomainSep) {l₁ r₁ l₂ r₂ : Digest48}
    (h : sep.node48Input l₁ r₁ = sep.node48Input l₂ r₂) : l₁ = l₂ ∧ r₁ = r₂ := by
  have hp : l₁.toBytes ++ r₁.toBytes = l₂.toBytes ++ r₂.toBytes := by
    simpa [node48Input] using congrArg KeyedInput.payload h
  exact pair48Bytes_injective hp

private theorem foldl_pushBytes_toList (acc : ByteArray) (xs : List Goldilocks) :
    (xs.foldl Goldilocks.pushBytes acc).data.toList =
      acc.data.toList ++ xs.flatMap goldilocksBytes := by
  induction xs generalizing acc with
  | nil => simp
  | cons a xs ih =>
    simp only [List.foldl_cons, List.flatMap_cons, ih, pushBytes_toList, List.append_assoc]

/-- `Hashers.rowBytes` is injective on canonical Goldilocks rows. -/
theorem rowBytes_injective {r₁ r₂ : Array Goldilocks}
    (h : Hashers.rowBytes r₁ = Hashers.rowBytes r₂) : r₁ = r₂ := by
  have hlist : (Hashers.rowBytes r₁).data.toList = (Hashers.rowBytes r₂).data.toList :=
    congrArg (fun b => b.data.toList) h
  simp only [Hashers.rowBytes, ← Array.foldl_toList, foldl_pushBytes_toList] at hlist
  have hnil : ∀ n, (ByteArray.emptyWithCapacity n).data.toList = [] := fun _ => rfl
  rw [hnil, hnil, List.nil_append, List.nil_append] at hlist
  exact Array.toList_inj.mp
    (flatMap_fixed_pos_injective (k := 8) (by decide) (fun _ => rfl)
      (fun _ _ => goldilocksBytes_injective) hlist)

private def extBytes (e : GoldilocksExt) : List UInt8 :=
  goldilocksBytes e.c0 ++ goldilocksBytes e.c1

private theorem foldl_extPushBytes_toList (acc : ByteArray) (xs : List GoldilocksExt) :
    (xs.foldl (fun bytes e => Goldilocks.pushBytes (Goldilocks.pushBytes bytes e.c0) e.c1)
        acc).data.toList =
      acc.data.toList ++ xs.flatMap extBytes := by
  induction xs generalizing acc with
  | nil => simp
  | cons e xs ih =>
    simp only [List.foldl_cons, List.flatMap_cons, ih, pushBytes_toList, extBytes, List.append_assoc]

/-- `Hashers.extRowBytes` is injective on quadratic-extension rows. -/
theorem extRowBytes_injective {r₁ r₂ : Array GoldilocksExt}
    (h : Hashers.extRowBytes r₁ = Hashers.extRowBytes r₂) : r₁ = r₂ := by
  have hlist : (Hashers.extRowBytes r₁).data.toList = (Hashers.extRowBytes r₂).data.toList :=
    congrArg (fun b => b.data.toList) h
  simp only [Hashers.extRowBytes, ← Array.foldl_toList, foldl_extPushBytes_toList] at hlist
  have hnil : ∀ n, (ByteArray.emptyWithCapacity n).data.toList = [] := fun _ => rfl
  rw [hnil, hnil, List.nil_append, List.nil_append] at hlist
  refine Array.toList_inj.mp
    (flatMap_fixed_pos_injective (k := 16) (by decide) (fun e => by simp [extBytes, goldilocksBytes])
      (fun e₁ e₂ he => ?_) hlist)
  have hpair := List.append_inj he (by simp [goldilocksBytes])
  cases e₁; cases e₂
  dsimp only at hpair
  rw [goldilocksBytes_injective hpair.1, goldilocksBytes_injective hpair.2]

private def ext3Bytes (e : GoldilocksExt3) : List UInt8 :=
  goldilocksBytes e.c0 ++ goldilocksBytes e.c1 ++ goldilocksBytes e.c2

private theorem foldl_ext3PushBytes_toList (acc : ByteArray) (xs : List GoldilocksExt3) :
    (xs.foldl GoldilocksExt3.pushBytes acc).data.toList =
      acc.data.toList ++ xs.flatMap ext3Bytes := by
  induction xs generalizing acc with
  | nil => simp
  | cons e xs ih =>
    simp only [List.foldl_cons, List.flatMap_cons, ih, GoldilocksExt3.pushBytes, pushBytes_toList,
      ext3Bytes, List.append_assoc]

/-- `Hashers.ext3RowBytes` is injective on cubic-extension rows. -/
theorem ext3RowBytes_injective {r₁ r₂ : Array GoldilocksExt3}
    (h : Hashers.ext3RowBytes r₁ = Hashers.ext3RowBytes r₂) : r₁ = r₂ := by
  have hlist : (Hashers.ext3RowBytes r₁).data.toList = (Hashers.ext3RowBytes r₂).data.toList :=
    congrArg (fun b => b.data.toList) h
  simp only [Hashers.ext3RowBytes, ← Array.foldl_toList, foldl_ext3PushBytes_toList] at hlist
  have hnil : ∀ n, (ByteArray.emptyWithCapacity n).data.toList = [] := fun _ => rfl
  rw [hnil, hnil, List.nil_append, List.nil_append] at hlist
  refine Array.toList_inj.mp
    (flatMap_fixed_pos_injective (k := 24) (by decide)
      (fun e => by simp [ext3Bytes, goldilocksBytes])
      (fun e₁ e₂ he => ?_) hlist)
  have h12 := List.append_inj he (by simp [goldilocksBytes])
  have h01 := List.append_inj h12.1 (by simp [goldilocksBytes])
  cases e₁; cases e₂
  dsimp only at h12 h01
  rw [goldilocksBytes_injective h01.1, goldilocksBytes_injective h01.2,
    goldilocksBytes_injective h12.2]

/-! ## `v6-zk` 16-byte salted Merkle leaf encodings and injectivity -/

/-- A 16-byte (128-bit) Merkle leaf salt (`ZK_LEAF_SALT_BYTES = 16` in
`multi-stark/v6-zk`), stored canonically as four little-endian 32-bit words. -/
structure Salt16 where
  w0 : UInt32
  w1 : UInt32
  w2 : UInt32
  w3 : UInt32
  deriving DecidableEq, Repr, Inhabited

/-- Canonical 16-byte little-endian encoding of a `Salt16`. -/
def Salt16.toBytes (s : Salt16) : ByteArray :=
  [s.w0, s.w1, s.w2, s.w3].foldl LittleEndian.pushWord32 (ByteArray.emptyWithCapacity 16)

private theorem salt16_toBytes_toList (s : Salt16) :
    s.toBytes.data.toList = [s.w0, s.w1, s.w2, s.w3].flatMap word32Bytes := by
  unfold Salt16.toBytes
  rw [foldl_pushWord32_toList]
  rfl

/-- Every `Salt16` encodes to exactly 16 bytes. -/
theorem salt16_toBytes_length (s : Salt16) : s.toBytes.data.toList.length = 16 := by
  rw [salt16_toBytes_toList]
  simp [word32Bytes]

/-- `Salt16.toBytes` is injective. -/
theorem salt16_toBytes_injective {s₁ s₂ : Salt16} (h : s₁.toBytes = s₂.toBytes) : s₁ = s₂ := by
  have hlist : s₁.toBytes.data.toList = s₂.toBytes.data.toList :=
    congrArg (fun b => b.data.toList) h
  rw [salt16_toBytes_toList, salt16_toBytes_toList] at hlist
  have hws := flatMap_fixed_pos_injective (k := 4) (by decide)
    (fun _ => rfl) (fun _ _ => word32Bytes_injective) hlist
  cases s₁; cases s₂
  simp only [List.cons.injEq, and_true] at hws
  obtain ⟨rfl, rfl, rfl, rfl⟩ := hws
  rfl

/-- `v6-zk` salted base-field Merkle leaf byte encoding:
`rowBytes row ++ salt.toBytes` (matching `multi-stark/v6-zk` `zk.rs`). -/
def saltedRowBytes (row : Array Goldilocks) (salt : Salt16) : ByteArray :=
  Hashers.rowBytes row ++ salt.toBytes

/-- `v6-zk` salted cubic-extension Merkle leaf byte encoding:
`ext3RowBytes row ++ salt.toBytes`. -/
def saltedExt3RowBytes (row : Array GoldilocksExt3) (salt : Salt16) : ByteArray :=
  Hashers.ext3RowBytes row ++ salt.toBytes

private theorem list_append_eq_of_suffix_length {α : Type} {a₁ a₂ b₁ b₂ : List α}
    (h : a₁ ++ b₁ = a₂ ++ b₂) (hb : b₁.length = b₂.length) : a₁ = a₂ ∧ b₁ = b₂ := by
  have hlen : a₁.length = a₂.length := by
    have := congrArg List.length h
    simp only [List.length_append] at this
    omega
  exact List.append_inj h hlen

/-- **`v6-zk` salted base-field leaf encoding is jointly injective in `(row, salt)`:**
appending a fixed-length 16-byte salt never creates ambiguity between distinct
rows or distinct salts. -/
theorem saltedRowBytes_injective {r₁ r₂ : Array Goldilocks} {s₁ s₂ : Salt16}
    (h : saltedRowBytes r₁ s₁ = saltedRowBytes r₂ s₂) : r₁ = r₂ ∧ s₁ = s₂ := by
  have hlist : (saltedRowBytes r₁ s₁).data.toList = (saltedRowBytes r₂ s₂).data.toList :=
    congrArg (fun b => b.data.toList) h
  simp only [saltedRowBytes, ByteArray.data_append, Array.toList_append] at hlist
  have hpair := list_append_eq_of_suffix_length hlist
    (by rw [salt16_toBytes_length, salt16_toBytes_length])
  refine ⟨rowBytes_injective ?_, salt16_toBytes_injective ?_⟩
  · cases h1 : Hashers.rowBytes r₁; cases h2 : Hashers.rowBytes r₂
    rw [h1, h2] at hpair
    exact congrArg ByteArray.mk (Array.toList_inj.mp hpair.1)
  · cases h1 : s₁.toBytes; cases h2 : s₂.toBytes
    rw [h1, h2] at hpair
    exact congrArg ByteArray.mk (Array.toList_inj.mp hpair.2)

/-- **`v6-zk` salted cubic-extension leaf encoding is jointly injective in `(row, salt)`.** -/
theorem saltedExt3RowBytes_injective {r₁ r₂ : Array GoldilocksExt3} {s₁ s₂ : Salt16}
    (h : saltedExt3RowBytes r₁ s₁ = saltedExt3RowBytes r₂ s₂) : r₁ = r₂ ∧ s₁ = s₂ := by
  have hlist : (saltedExt3RowBytes r₁ s₁).data.toList = (saltedExt3RowBytes r₂ s₂).data.toList :=
    congrArg (fun b => b.data.toList) h
  simp only [saltedExt3RowBytes, ByteArray.data_append, Array.toList_append] at hlist
  have hpair := list_append_eq_of_suffix_length hlist
    (by rw [salt16_toBytes_length, salt16_toBytes_length])
  refine ⟨ext3RowBytes_injective ?_, salt16_toBytes_injective ?_⟩
  · cases h1 : Hashers.ext3RowBytes r₁; cases h2 : Hashers.ext3RowBytes r₂
    rw [h1, h2] at hpair
    exact congrArg ByteArray.mk (Array.toList_inj.mp hpair.1)
  · cases h1 : s₁.toBytes; cases h2 : s₂.toBytes
    rw [h1, h2] at hpair
    exact congrArg ByteArray.mk (Array.toList_inj.mp hpair.2)

/-- Domain-separated `v6-zk` salted base-field Merkle leaf invocation input. -/
def saltedLeafInput (sep : DomainSep) (row : Array Goldilocks) (salt : Salt16) : KeyedInput :=
  sep.leafInput (saltedRowBytes row salt)

/-- Domain-separated `v6-zk` salted cubic-extension Merkle leaf invocation input. -/
def saltedExt3LeafInput (sep : DomainSep) (row : Array GoldilocksExt3) (salt : Salt16) :
    KeyedInput :=
  sep.leafInput (saltedExt3RowBytes row salt)

/-- `saltedLeafInput` is jointly injective in `(row, salt)` under any `DomainSep`. -/
theorem saltedLeafInput_injective (sep : DomainSep) {r₁ r₂ : Array Goldilocks} {s₁ s₂ : Salt16}
    (h : sep.saltedLeafInput r₁ s₁ = sep.saltedLeafInput r₂ s₂) : r₁ = r₂ ∧ s₁ = s₂ := by
  have hp : saltedRowBytes r₁ s₁ = saltedRowBytes r₂ s₂ := by
    simpa [saltedLeafInput, leafInput] using congrArg KeyedInput.payload h
  exact saltedRowBytes_injective hp

/-- `saltedExt3LeafInput` is jointly injective in `(row, salt)` under any `DomainSep`. -/
theorem saltedExt3LeafInput_injective (sep : DomainSep) {r₁ r₂ : Array GoldilocksExt3}
    {s₁ s₂ : Salt16}
    (h : sep.saltedExt3LeafInput r₁ s₁ = sep.saltedExt3LeafInput r₂ s₂) : r₁ = r₂ ∧ s₁ = s₂ := by
  have hp : saltedExt3RowBytes r₁ s₁ = saltedExt3RowBytes r₂ s₂ := by
    simpa [saltedExt3LeafInput, leafInput] using congrArg KeyedInput.payload h
  exact saltedExt3RowBytes_injective hp

/-- A salted leaf invocation never collides with an internal Merkle node invocation. -/
theorem saltedLeafInput_ne_nodeInput (sep : DomainSep) (row : Array Goldilocks) (salt : Salt16)
    (left right : Digest) :
    sep.saltedLeafInput row salt ≠ sep.nodeInput left right :=
  sep.leafInput_ne_nodeInput (saltedRowBytes row salt) left right

/-- A salted leaf invocation never collides with a 48B internal Merkle node invocation. -/
theorem saltedLeafInput_ne_node48Input (sep : DomainSep) (row : Array Goldilocks) (salt : Salt16)
    (left right : Digest48) :
    sep.saltedLeafInput row salt ≠ sep.node48Input left right :=
  sep.leafInput_ne_node48Input (saltedRowBytes row salt) left right

/-- A salted leaf invocation never collides with a Fiat–Shamir transcript invocation. -/
theorem saltedLeafInput_ne_transcriptInput (sep : DomainSep) (row : Array Goldilocks)
    (salt : Salt16) (input : ByteArray) :
    sep.saltedLeafInput row salt ≠ sep.transcriptInput input :=
  sep.leafInput_ne_transcriptInput (saltedRowBytes row salt) input

/-- A `v6-zk` salted leaf invocation never collides with a non-ZK `v6` leaf invocation. -/
theorem v6Zk_leafInput_ne_v6_leafInput (p₁ p₂ : ByteArray) :
    v6ZkSingle.leafInput p₁ ≠ v6Single.leafInput p₂ :=
  fun h => (by decide : v6ZkMerkleLeafKey ≠ v6MerkleLeafKey) (congrArg KeyedInput.contextKey h)

/-- A `v6-zk` internal node invocation never collides with a non-ZK `v6` internal node invocation. -/
theorem v6Zk_nodeInput_ne_v6_nodeInput (l₁ r₁ l₂ r₂ : Digest) :
    v6ZkSingle.nodeInput l₁ r₁ ≠ v6Single.nodeInput l₂ r₂ :=
  fun h =>
    (by decide : v6ZkMerkleCompressKey ≠ v6MerkleCompressKey) (congrArg KeyedInput.contextKey h)

/-- A `v6-zk` single-proof transcript invocation never collides with a non-ZK `v6` transcript. -/
theorem v6Zk_transcriptSingle_ne_v6_transcriptSingle (p₁ p₂ : ByteArray) :
    v6ZkSingle.transcriptInput p₁ ≠ v6Single.transcriptInput p₂ :=
  fun h =>
    (by decide : v6ZkTranscriptSingleKey ≠ v6TranscriptSingleKey)
      (congrArg KeyedInput.contextKey h)

/-- A `v6-zk` batch-proof transcript invocation never collides with a non-ZK `v6` transcript. -/
theorem v6Zk_transcriptBatch_ne_v6_transcriptBatch (p₁ p₂ : ByteArray) :
    v6ZkBatch.transcriptInput p₁ ≠ v6Batch.transcriptInput p₂ :=
  fun h =>
    (by decide : v6ZkTranscriptBatchKey ≠ v6TranscriptBatchKey)
      (congrArg KeyedInput.contextKey h)

end DomainSep

/-! ## Native BLAKE3 `derive_key` Merkle hashers and Fiat–Shamir challengers -/

/-- Native BLAKE3 `derive_key` Merkle hasher over `Goldilocks` (1 compression block
per 64-byte internal Merkle node). Defaults to `multi-stark` `v6`. -/
def baseHasherSep (sep : DomainSep := .standard) : MerkleHasher Goldilocks Digest where
  hashRows row := Blake3.deriveKeyBlocks sep.leafKey (8 * row.size) (Hashers.rowBlock row)
  compress left right := Blake3.deriveKeyPair sep.compressKey left right

/-- Native BLAKE3 `derive_key` Merkle hasher over `GoldilocksExt` (1 compression
block per 64-byte internal Merkle node). Defaults to `multi-stark` `v6`. -/
def extHasherSep (sep : DomainSep := .standard) : MerkleHasher GoldilocksExt Digest where
  hashRows row := Blake3.deriveKeyBlocks sep.leafKey (16 * row.size) (Hashers.extRowBlock row)
  compress left right := Blake3.deriveKeyPair sep.compressKey left right

/-- Native BLAKE3 `derive_key` Merkle hasher over `GoldilocksExt3` (1 compression
block per 64-byte internal Merkle node). Defaults to `multi-stark` `v6`. -/
def ext3HasherSep (sep : DomainSep := .standard) : MerkleHasher GoldilocksExt3 Digest where
  hashRows row := Blake3.deriveKeyBlocks sep.leafKey (24 * row.size) (Hashers.ext3RowBlock row)
  compress left right := Blake3.deriveKeyPair sep.compressKey left right

/-- 48-byte (384-bit) BLAKE3 `derive_key` XOF Merkle hasher over `Goldilocks`
(2 blocks per 96-byte internal node, 1 root output block). -/
def baseHasherSepXof48 (sep : DomainSep := .standard) : MerkleHasher Goldilocks Digest48 where
  hashRows row := Blake3.deriveKeyBlocksXof48 sep.leafKey (8 * row.size) (Hashers.rowBlock row)
  compress left right := Blake3.deriveKeyPairXof48 sep.compressKey left right

/-- 48-byte (384-bit) BLAKE3 `derive_key` XOF Merkle hasher over `GoldilocksExt3`
(2 blocks per 96-byte internal node, 1 root output block). -/
def ext3HasherSepXof48 (sep : DomainSep := .standard) : MerkleHasher GoldilocksExt3 Digest48 where
  hashRows row :=
    Blake3.deriveKeyBlocksXof48 sep.leafKey (24 * row.size) (Hashers.ext3RowBlock row)
  compress left right := Blake3.deriveKeyPairXof48 sep.compressKey left right

/-- Native BLAKE3 `derive_key` byte hash for the Fiat–Shamir challenger (32 bytes). -/
def blake3Transcript (sep : DomainSep := .standard) (input : ByteArray) : ByteArray :=
  (Blake3.deriveKeyWithKey sep.transcriptKey input).toBytes

/-- Native BLAKE3 `derive_key` XOF byte hash for the Fiat–Shamir challenger (48 bytes). -/
def blake3TranscriptXof48 (sep : DomainSep := .standard) (input : ByteArray) : ByteArray :=
  (Blake3.deriveKeyWithKeyXof48 sep.transcriptKey input).toBytes

/-- Native BLAKE3 `derive_key` challenger over `Goldilocks` / `GoldilocksExt`. -/
def challengerSep (sep : DomainSep := .standard) :
    Challenger ChallengerState Goldilocks GoldilocksExt Digest :=
  challengerWith (blake3Transcript sep)

/-- Native BLAKE3 `derive_key` challenger over `Goldilocks` / `GoldilocksExt3`. -/
def challenger3Sep (sep : DomainSep := .standard) :
    Challenger ChallengerState Goldilocks GoldilocksExt3 Digest :=
  challenger3With (blake3Transcript sep)

/-- `multi-stark` `v6` single-proof challenger over `Goldilocks` / `GoldilocksExt3`. -/
def challenger3V6Single : Challenger ChallengerState Goldilocks GoldilocksExt3 Digest :=
  challenger3Sep .v6Single

/-- `multi-stark` `v6` batch-proof challenger over `Goldilocks` / `GoldilocksExt3`. -/
def challenger3V6Batch : Challenger ChallengerState Goldilocks GoldilocksExt3 Digest :=
  challenger3Sep .v6Batch

/-- 48-byte XOF `multi-stark` `v6` challenger over `Goldilocks` / `GoldilocksExt3`. -/
def challenger3Xof48 (sep : DomainSep := .standard) :
    Challenger ChallengerState Goldilocks GoldilocksExt3 Digest48 where
  observe s
    | .base a => s.observeBytes (a.pushBytes ByteArray.empty)
    | .ext e => s.observeBytes (e.pushBytes ByteArray.empty)
    | .digest d => s.observeBytes d.toBytes
  sampleExt := ChallengerState.sampleExt3 (blake3TranscriptXof48 sep)
  sampleBits := ChallengerState.sampleBits (blake3TranscriptXof48 sep)

/-- `v6-zk` salted Merkle leaf hash (32-byte digest) under `ZkMerkleLeaf`. -/
def hashSaltedRow (row : Array Goldilocks) (salt : DomainSep.Salt16) : Digest :=
  Blake3Domain.zkMerkleLeaf.hash (DomainSep.saltedRowBytes row salt)

/-- `v6-zk` salted Merkle leaf hash (48-byte XOF digest) under `ZkMerkleLeaf`. -/
def hashSaltedRowXof48 (row : Array Goldilocks) (salt : DomainSep.Salt16) : Digest48 :=
  Blake3Domain.zkMerkleLeaf.hashXof48 (DomainSep.saltedRowBytes row salt)

/-- `multi-stark` `v6-zk` single-proof challenger over `Goldilocks` / `GoldilocksExt3`. -/
def challenger3V6ZkSingle : Challenger ChallengerState Goldilocks GoldilocksExt3 Digest :=
  challenger3Sep .v6ZkSingle

/-- `multi-stark` `v6-zk` batch-proof challenger over `Goldilocks` / `GoldilocksExt3`. -/
def challenger3V6ZkBatch : Challenger ChallengerState Goldilocks GoldilocksExt3 Digest :=
  challenger3Sep .v6ZkBatch

/-- 48-byte XOF `multi-stark` `v6-zk` single-proof challenger over `Goldilocks` / `GoldilocksExt3`. -/
def challenger3V6ZkXof48 : Challenger ChallengerState Goldilocks GoldilocksExt3 Digest48 :=
  challenger3Xof48 .v6ZkSingle

end CertiFri.P3
