import Lean.Data.Json
import CertiFri.Pcs
import CertiFriP3.DomainSep
import CertiFriP3.Pruned

/-!
# Differential tests for `Fri.verifyTensor` and `Fri.verifyFromTensor`

Cross-checks the executable tensor-batched FRI verifier (`CertiFri.Fri.verifyTensor`,
`verifyFromTensor`, `verifyClaimsTensor`, `verifyClaimsFromTensor`) against real
`FriBatching::Tensor` opening proofs generated by `multi-stark` (`v6` native BLAKE3
`derive_key` domain separation over `Goldilocks` and `GoldilocksExt3`, arity-2 folding):

* `tensor_mixed.json`: 2 batches, mixed heights (`logDegree ∈ {3, 4, 5}`), mixed widths
  (`5, 1, 9, 3`, so `kCol = 4`), `maxOpeningsPerHeight = 4` (`kOpen = 2`), 4 folding
  rounds, commit PoW = 2 bits, query PoW = 4 bits.
* `tensor_const.json`: `logFinalPolyLen = 0` (constant final polynomial, including a
  matrix at `logDegree = 0` whose reduced opening at the final level must vanish),
  2 batches, widths `3, 2, 5` (`kCol = 3`), `maxOpeningsPerHeight = 2` (`kOpen = 1`),
  3 folding rounds, commit PoW = 1 bit, query PoW = 3 bits.

Checks:
1. Every derived challenge (`colChallenges`, `openChallenges`, `betas`, `indices`, `powOk`)
   matches `multi-stark` byte-for-byte.
2. Both `verifyClaimsTensor` / `verifyTensor` and `verifyClaimsFromTensor` / `verifyFromTensor`
   accept the proofs under both `prunedMmcs` (the exact Plonky3 pruned Merkle proof bytes)
   and `merkleMmcs` (expanded per-query full Merkle paths).
3. Tampering with commitments, opening points, claimed evaluations, opened matrix entries,
   folding sibling values, final polynomial coefficients, proof-of-work witnesses, or
   parameters is rejected.
-/

namespace CertiFriTest.P3.FriTensor

open Lean (Json)
open CertiFri CertiFri.Fri CertiFri.P3

private abbrev Parse := Except String

private def parseField (j : Json) : Parse Goldilocks := do
  let n ← j.getNat?
  if n < Goldilocks.order then pure (Goldilocks.ofNat n)
  else throw s!"field element {n} is not canonical"

private def parseArray {α : Type} (f : Json → Parse α) (j : Json) : Parse (Array α) := do
  (← j.getArr?).mapM f

private def parseExt3 (j : Json) : Parse GoldilocksExt3 := do
  let coords ← parseArray parseField j
  match coords with
  | #[c0, c1, c2] => pure ⟨c0, c1, c2⟩
  | _ => throw "a cubic extension element has three coordinates"

private def parseDigest (j : Json) : Parse Digest := do
  let bytes ← parseArray (fun b => do
    let n ← b.getNat?
    if n < 256 then pure n.toUInt8 else throw s!"{n} is not a byte") j
  match Digest.ofBytes? (ByteArray.mk bytes) with
  | some d => pure d
  | none => throw "a digest has 32 bytes"

private def parseKey {α : Type} (j : Json) (key : String) (f : Json → Parse α) : Parse α := do
  f (← j.getObjVal? key)

private def parseNat (j : Json) : Parse Nat := j.getNat?

private def parseParams (j : Json) : Parse FriParams := do
  pure {
    logBlowup := ← parseKey j "log_blowup" parseNat
    logFinalPolyLen := ← parseKey j "log_final_poly_len" parseNat
    maxLogArity := ← parseKey j "max_log_arity" parseNat
    numQueries := ← parseKey j "num_queries" parseNat
    commitPowBits := ← parseKey j "commit_proof_of_work_bits" parseNat
    queryPowBits := ← parseKey j "query_proof_of_work_bits" parseNat }

private def parseClaims (j : Json) : Parse (Array (CommitmentOpening GoldilocksExt3 Digest)) :=
  parseArray (fun batch => do
    pure {
      commitment := ← parseKey batch "commitment" parseDigest
      matrices := ← parseKey batch "matrices" (parseArray fun matrix => do
        pure {
          logDegree := ← parseKey matrix "log_degree" parseNat
          points := ← parseKey matrix "points" (parseArray fun point => do
            pure {
              point := ← parseKey point "point" parseExt3
              values := ← parseKey point "values" (parseArray parseExt3) }) }) }) j

private def parsePruned (j : Json) : Parse (PrunedPaths Digest) := do
  let pruned ← j.getObjVal? "pruned"
  pure ⟨← parseKey pruned "sibling_hashes" (parseArray parseDigest)⟩

private def parseProof (j : Json) :
    Parse (FriProof Goldilocks GoldilocksExt3 Digest (PrunedPaths Digest) (PrunedPaths Digest)) := do
  pure {
    commitPhaseCommits := ← parseKey j "commit_phase_commits" (parseArray parseDigest)
    commitPowWitnesses := ← parseKey j "commit_pow_witnesses" (parseArray parseField)
    inputOpenings := ← parseKey j "input_openings" (parseArray fun o => do
      pure {
        openedValues := ← parseKey o "opened_values"
          (parseArray (parseArray (parseArray parseField)))
        openingProof := ← parseKey o "opening_proof" parsePruned })
    commitPhaseOpenings := ← parseKey j "commit_phase_openings" (parseArray fun o => do
      pure {
        logArity := ← parseKey o "log_arity" parseNat
        siblingValues := ← parseKey o "sibling_values" (parseArray (parseArray parseExt3))
        openingProof := ← parseKey o "opening_proof" parsePruned })
    finalPoly := ← parseKey j "final_poly" (parseArray parseExt3)
    queryPowWitness := ← parseKey j "query_pow_witness" parseField }

structure TensorVector where
  params : FriParams
  claims : Array (CommitmentOpening GoldilocksExt3 Digest)
  pruned : FriProof Goldilocks GoldilocksExt3 Digest (PrunedPaths Digest) (PrunedPaths Digest)
  colChallenges : Array GoldilocksExt3
  openChallenges : Array GoldilocksExt3
  betas : Array GoldilocksExt3
  indices : Array Nat

private def parseVector (text : String) : Parse TensorVector := do
  let j ← Json.parse text
  let proof ← j.getObjVal? "proof"
  let debug ← j.getObjVal? "debug"
  pure {
    params := ← parseKey j "params" parseParams
    claims := ← parseKey j "claims" parseClaims
    pruned := ← parseProof proof
    colChallenges := ← parseKey debug "col_challenges" (parseArray parseExt3)
    openChallenges := ← parseKey debug "open_challenges" (parseArray parseExt3)
    betas := ← parseKey debug "betas" (parseArray parseExt3)
    indices := ← parseKey debug "indices" (parseArray parseNat) }

private def initial : ChallengerState := ChallengerState.new ByteArray.empty

private def inputH : MerkleHasher Goldilocks Digest := baseHasherSep .v6Single
private def friH : MerkleHasher GoldilocksExt3 Digest := ext3HasherSep .v6Single
private def chal : Challenger ChallengerState Goldilocks GoldilocksExt3 Digest := challenger3V6Single

private def challenges (v : TensorVector) : TensorChallenges GoldilocksExt3 :=
  transcriptTensor chal initial v.params (claimShape v.claims) (v.claims.map (·.commitment))
    (claimPoints v.claims) (claimValues v.claims) v.pruned

private def challengesMatch (v : TensorVector) : Bool :=
  let ch := challenges v
  ch.schedule.colChallenges == v.colChallenges
    && ch.schedule.openChallenges == v.openChallenges
    && ch.betas == v.betas
    && ch.indices == v.indices
    && ch.powOk

private def acceptsPruned (v : TensorVector) : Bool :=
  verifyClaimsTensor (prunedMmcs inputH) (prunedMmcs friH) chal initial v.params v.claims v.pruned

private def acceptsFromPruned (v : TensorVector) : Bool :=
  let s := chal.observeAll initial
    ((v.claims.map (·.commitment)).toList.map .digest ++ (claimPoints v.claims).toList.map .ext)
  verifyClaimsFromTensor (prunedMmcs inputH) (prunedMmcs friH) chal s v.params v.claims v.pruned

/-- Expand Plonky3 pruned proofs in `v.pruned` into full per-query Merkle paths and verify
with `merkleMmcs` (the commitment scheme proved sound in `Proofs/`). -/
private def expandToPaths (v : TensorVector) :
    Option (FriProof Goldilocks GoldilocksExt3 Digest (Array (List Digest)) (Array (List Digest))) := do
  let shape := claimShape v.claims
  let n := logMaxHeight v.params.logBlowup shape
  let rounds := numRounds v.params shape
  let ch := challenges v
  let levelArr := Array.ofFn (n := rounds + 1) fun j => levelOpenings v.params.logBlowup shape n j.val
  let results := Array.ofFn (n := v.params.numQueries) fun t =>
    checkQueryTensor (F := Goldilocks) v.params shape (fun j => levelArr.getD j [])
      (claimPoints v.claims) (claimValues v.claims) v.pruned ch t.val (ch.indices.getD t.val 0)
  let rows := results.map (·.rows)
  let inputOpenings ← (List.range shape.length).mapM fun b => do
    let o ← v.pruned.inputOpenings[b]?
    let dims := batchDims v.params.logBlowup (shape.getD b [])
    let idxs := Array.ofFn (n := v.params.numQueries) fun t =>
      ch.indices.getD t.val 0 >>> (n - Merkle.maxLogHeight dims.toList)
    let paths ← restorePaths inputH dims idxs o.openedValues o.openingProof
    pure { openedValues := o.openedValues, openingProof := paths }
  let commitPhaseOpenings ← (List.range rounds).mapM fun i => do
    let o ← v.pruned.commitPhaseOpenings[i]?
    let idxs := Array.ofFn (n := v.params.numQueries) fun t => ch.indices.getD t.val 0 >>> (i + 1)
    let opened := Array.ofFn (n := v.params.numQueries) fun t =>
      #[#[((rows.getD t.val []).getD i (0, 0)).1, ((rows.getD t.val []).getD i (0, 0)).2]]
    let paths ← restorePaths friH #[⟨2, n - i - 1⟩] idxs opened o.openingProof
    pure { logArity := o.logArity, siblingValues := o.siblingValues, openingProof := paths }
  pure {
    commitPhaseCommits := v.pruned.commitPhaseCommits
    commitPowWitnesses := v.pruned.commitPowWitnesses
    inputOpenings := inputOpenings.toArray
    commitPhaseOpenings := commitPhaseOpenings.toArray
    finalPoly := v.pruned.finalPoly
    queryPowWitness := v.pruned.queryPowWitness }

private def acceptsFullPaths (v : TensorVector) : Bool :=
  match expandToPaths v with
  | some full =>
    verifyClaimsTensor (merkleMmcs inputH) (merkleMmcs friH) chal initial v.params v.claims full
  | none => false

private def check (text : String) (f : TensorVector → Bool) : Bool :=
  match parseVector text with
  | .ok v => f v
  | .error _ => false

private def tensorMixed : String := include_str "../vectors/fri/tensor_mixed.json"
private def tensorConst : String := include_str "../vectors/fri/tensor_const.json"

/-! ## Real `multi-stark` tensor-batched proofs are accepted -/

#guard check tensorMixed challengesMatch
#guard check tensorConst challengesMatch

#guard check tensorMixed acceptsPruned
#guard check tensorConst acceptsPruned

#guard check tensorMixed acceptsFromPruned
#guard check tensorConst acceptsFromPruned

#guard check tensorMixed acceptsFullPaths
#guard check tensorConst acceptsFullPaths

#guard check tensorMixed fun v =>
  let shape := claimShape v.claims
  numRounds v.params shape == 4
    && maxWidth shape == 9
    && maxOpeningsPerHeight v.params.logBlowup shape == 4
    && v.colChallenges.size == 4
    && v.openChallenges.size == 2

#guard check tensorConst fun v =>
  let shape := claimShape v.claims
  numRounds v.params shape == 3
    && v.params.logFinalPolyLen == 0
    && maxWidth shape == 5
    && maxOpeningsPerHeight v.params.logBlowup shape == 2
    && v.colChallenges.size == 3
    && v.openChallenges.size == 1

/-! ## Tampered statements and proofs are rejected -/

private def bumpExt (x : GoldilocksExt3) : GoldilocksExt3 := x + 1

private def bumpCommitment (v : TensorVector) (b : Nat) : TensorVector :=
  { v with claims := v.claims.modify b fun c =>
      { c with commitment := { c.commitment with w0 := c.commitment.w0 ^^^ 1 } } }

private def bumpValue (v : TensorVector) (b m p cIdx : Nat) : TensorVector :=
  { v with claims := v.claims.modify b fun batch =>
      { batch with matrices := batch.matrices.modify m fun mat =>
          { mat with points := mat.points.modify p fun pt =>
              { pt with values := pt.values.modify cIdx bumpExt } } } }

private def bumpPoint (v : TensorVector) (b m p : Nat) : TensorVector :=
  { v with claims := v.claims.modify b fun batch =>
      { batch with matrices := batch.matrices.modify m fun mat =>
          { mat with points := mat.points.modify p fun pt =>
              { pt with point := bumpExt pt.point } } } }

private def bumpFinal (v : TensorVector) : TensorVector :=
  { v with pruned := { v.pruned with finalPoly := v.pruned.finalPoly.modify 0 bumpExt } }

private def bumpSibling (v : TensorVector) (i : Nat) : TensorVector :=
  { v with pruned := { v.pruned with commitPhaseOpenings :=
      v.pruned.commitPhaseOpenings.modify i fun o =>
        { o with siblingValues := o.siblingValues.modify 0 fun s => s.modify 0 bumpExt } } }

private def bumpOpened (v : TensorVector) (b m : Nat) : TensorVector :=
  let io := v.pruned.inputOpenings.modify b fun o =>
    { o with openedValues := o.openedValues.modify 0 fun rows =>
        rows.modify m fun row => row.modify 0 (· + 1) }
  { v with pruned := { v.pruned with inputOpenings := io } }

private def bumpQueryWitness (v : TensorVector) : TensorVector :=
  { v with pruned := { v.pruned with queryPowWitness := v.pruned.queryPowWitness + 1 } }

private def bumpCommitWitness (v : TensorVector) (i : Nat) : TensorVector :=
  { v with pruned := { v.pruned with commitPowWitnesses :=
      v.pruned.commitPowWitnesses.modify i (· + 1) } }

private def rejects (v : TensorVector) : Bool := !acceptsPruned v && !acceptsFromPruned v

-- Tampered commitment digests.
#guard check tensorMixed fun v => rejects (bumpCommitment v 0) && rejects (bumpCommitment v 1)

-- Tampered claimed values across every batch, matrix, opening point, and first/last column.
#guard check tensorMixed fun v =>
  rejects (bumpValue v 0 0 0 0) && rejects (bumpValue v 0 0 1 4)
    && rejects (bumpValue v 0 1 0 0)
    && rejects (bumpValue v 1 0 0 0) && rejects (bumpValue v 1 0 1 8)
    && rejects (bumpValue v 1 1 0 0) && rejects (bumpValue v 1 1 1 2)
#guard check tensorConst fun v =>
  rejects (bumpValue v 0 0 0 0) && rejects (bumpValue v 0 1 0 1) && rejects (bumpValue v 1 0 1 4)

-- Tampered opening points.
#guard check tensorMixed fun v =>
  rejects (bumpPoint v 0 0 0) && rejects (bumpPoint v 0 0 1)
    && rejects (bumpPoint v 1 0 0) && rejects (bumpPoint v 1 1 1)

-- Tampered final polynomial.
#guard check tensorMixed fun v => rejects (bumpFinal v)
#guard check tensorConst fun v => rejects (bumpFinal v)

-- Tampered folding siblings in every round.
#guard check tensorMixed fun v => (List.range 4).all fun i => rejects (bumpSibling v i)
#guard check tensorConst fun v => (List.range 3).all fun i => rejects (bumpSibling v i)

-- Tampered opened input matrix entries.
#guard check tensorMixed fun v =>
  rejects (bumpOpened v 0 0) && rejects (bumpOpened v 0 1)
    && rejects (bumpOpened v 1 0) && rejects (bumpOpened v 1 1)

-- Tampered PoW witnesses.
#guard check tensorMixed fun v =>
  rejects (bumpQueryWitness v) && (List.range 4).all fun i => rejects (bumpCommitWitness v i)

-- Mismatched parameters.
#guard check tensorMixed fun v => rejects { v with params := { v.params with numQueries := 3 } }
#guard check tensorMixed fun v => rejects { v with params := { v.params with logBlowup := 1 } }
#guard check tensorMixed fun v => rejects { v with params := { v.params with queryPowBits := 20 } }

end CertiFriTest.P3.FriTensor
