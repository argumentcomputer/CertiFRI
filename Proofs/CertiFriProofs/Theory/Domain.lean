import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots
import Mathlib.Algebra.Polynomial.Eval.Degree
import Mathlib.Data.Nat.Bitwise
import CertiFriProofs.Theory.Basic
import CertiFriProofs.Theory.Domain.Bits

/-!
# The concrete evaluation domains

`Theory/Basic.lean` states the low-degree test over abstract domains. This file
shows that the domains the verifier uses are instances of them, and connects
the verifier's integer query indices to domain points.

* **Two-adic domains.** `twoAdicDomain ω n i` is the subgroup of order
  `2 ^ (n - i)` generated by `ω ^ 2 ^ i`. Consecutive subgroups form a
  `SquareStep`, and `twoAdicInstance` packages them as an `LdtInstance`.
* **Query indices.** Plonky3 stores codewords in bit-reversed order: the index
  `index` at log-height `h` names the point `pointOfIndex ω n h index`. Halving
  the index squares the point, flipping the low bit negates it, and
  `pointOfIndex ω n h` is a bijection from the indices below `2 ^ h` onto the
  subgroup of order `2 ^ h`.
* **Cosets.** Plonky3 commits to evaluations on a coset `s * H` and runs the
  test on `H`. Being a codeword, or close to one, on `s * D` is the same as
  the reparametrized function being so on `D`.

Assumptions. Throughout, `ω` is a primitive `2 ^ n`-th root of unity in a field
`F`, and the generator of the subgroup of order `2 ^ h` is `ω ^ 2 ^ (n - h)`.
This matches Plonky3's `two_adic_generator(h)` when its generators are
compatible, that is when squaring the generator of order `2 ^ (h + 1)` gives the
generator of order `2 ^ h` (`Domain.generator_eq_pow`). Each theorem lists the
bounds it needs. The index lemmas need no bound on the index unless they say
so, because `reverseBitsLen index h` reads only the low `h` bits of `index`.
The facts about `reverseBitsLen` are in `Theory/Domain/Bits.lean`.

Not covered. Folding with arity above two, the reduction of a batch of
polynomial openings to the functions the test runs on, and any statement about
the executable verifier: the lemmas here are the arithmetic such a refinement
rests on.
-/

namespace CertiFri

open Polynomial

variable {F : Type*} [Field F]

/-! ## Two-adic domains -/

namespace Domain

/-- `ω ^ 2 ^ i` generates the subgroup of order `2 ^ (n - i)`. -/
theorem isPrimitiveRoot_pow_two_pow {ω : F} {n : ℕ} (hω : IsPrimitiveRoot ω (2 ^ n)) {i : ℕ}
    (hi : i ≤ n) : IsPrimitiveRoot (ω ^ 2 ^ i) (2 ^ (n - i)) :=
  hω.pow (by positivity) (by rw [← pow_add, Nat.add_sub_cancel' hi])

/-- `ω ^ 2 ^ (n - h)` generates the subgroup of order `2 ^ h`. In Plonky3 it is
`two_adic_generator(h)`. -/
theorem isPrimitiveRoot_generator {ω : F} {n : ℕ} (hω : IsPrimitiveRoot ω (2 ^ n)) {h : ℕ}
    (hh : h ≤ n) : IsPrimitiveRoot (ω ^ 2 ^ (n - h)) (2 ^ h) := by
  simpa [Nat.sub_sub_self hh] using isPrimitiveRoot_pow_two_pow hω (Nat.sub_le n h)

/-- Compatible generators are powers of the largest one: if squaring `g (h + 1)`
gives `g h` for every `h < n`, then `g h = g n ^ 2 ^ (n - h)`. With
`g = two_adic_generator` and `ω = g n`, this is the form the generators take in
this file. -/
theorem generator_eq_pow {g : ℕ → F} {n : ℕ} (hg : ∀ h < n, g (h + 1) ^ 2 = g h) {h : ℕ}
    (hh : h ≤ n) : g h = g n ^ 2 ^ (n - h) := by
  induction hh using Nat.decreasingInduction with
  | self => simp
  | of_succ k hk ih =>
    have e : n - k = n - (k + 1) + 1 := by omega
    rw [← hg k hk, ih, e, pow_succ 2, pow_mul]

/-- The element of order two is `-1`. -/
theorem pow_two_pow_pred {ω : F} {n : ℕ} (hω : IsPrimitiveRoot ω (2 ^ n)) (hn : 0 < n) :
    ω ^ 2 ^ (n - 1) = -1 := by
  have h := isPrimitiveRoot_generator hω (h := 1) hn
  rw [pow_one] at h
  exact h.eq_neg_one_of_two_right

/-- A field with a primitive `2 ^ n`-th root of unity, `n ≥ 1`, has characteristic
other than two. -/
theorem two_ne_zero_of_isPrimitiveRoot {ω : F} {n : ℕ} (hω : IsPrimitiveRoot ω (2 ^ n))
    (hn : 0 < n) : (2 : F) ≠ 0 := by
  intro h2
  have h := isPrimitiveRoot_generator hω (h := 1) hn
  rw [pow_one] at h
  refine h.ne_one one_lt_two ?_
  rw [pow_two_pow_pred hω hn]
  linear_combination (-1 : F) * h2

end Domain

/-- The subgroup of order `2 ^ (n - i)`, generated by `ω ^ 2 ^ i`: the evaluation
domain after `i` folds. -/
def twoAdicDomain [DecidableEq F] (ω : F) (n i : ℕ) : Finset F :=
  (Finset.range (2 ^ (n - i))).image fun j => (ω ^ 2 ^ i) ^ j

section TwoAdicDomain

variable [DecidableEq F] {ω : F} {n : ℕ}

/-- The domain after `i` folds has `2 ^ (n - i)` points. -/
theorem card_twoAdicDomain (hω : IsPrimitiveRoot ω (2 ^ n)) {i : ℕ} (hi : i ≤ n) :
    (twoAdicDomain ω n i).card = 2 ^ (n - i) := by
  rw [twoAdicDomain, Finset.card_image_of_injOn, Finset.card_range]
  intro a ha b hb hab
  exact (Domain.isPrimitiveRoot_pow_two_pow hω hi).pow_inj (by simpa using ha) (by simpa using hb)
    hab

/-- The domain after `i` folds is the set of `2 ^ (n - i)`-th roots of unity. -/
theorem mem_twoAdicDomain_iff (hω : IsPrimitiveRoot ω (2 ^ n)) {i : ℕ} (hi : i ≤ n) {x : F} :
    x ∈ twoAdicDomain ω n i ↔ x ^ 2 ^ (n - i) = 1 := by
  have hζ := Domain.isPrimitiveRoot_pow_two_pow hω hi
  simp only [twoAdicDomain, Finset.mem_image, Finset.mem_range]
  constructor
  · rintro ⟨j, -, rfl⟩
    rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
  · intro hx
    have : NeZero (2 ^ (n - i)) := ⟨by positivity⟩
    exact hζ.eq_pow_of_pow_eq_one hx

/-- Squaring is two-to-one from each two-adic domain onto the next. -/
theorem squareStep_twoAdicDomain (hω : IsPrimitiveRoot ω (2 ^ n)) {i : ℕ} (hi : i < n) :
    SquareStep (twoAdicDomain ω n i) (twoAdicDomain ω n (i + 1)) := by
  have hk : n - i = n - (i + 1) + 1 := by omega
  have hsq : ∀ x : F, x ^ 2 ^ (n - i) = (x ^ 2) ^ 2 ^ (n - (i + 1)) := fun x => by
    rw [hk, pow_succ', pow_mul]
  refine ⟨Domain.two_ne_zero_of_isPrimitiveRoot hω (by omega), ?_, ?_, ?_, ?_⟩
  · intro x hx h0
    rw [mem_twoAdicDomain_iff hω hi.le, h0, zero_pow (by positivity)] at hx
    exact zero_ne_one hx
  · intro x hx
    rw [mem_twoAdicDomain_iff hω hi.le] at hx ⊢
    rw [hsq, neg_sq, ← hsq, hx]
  · intro x hx
    rw [mem_twoAdicDomain_iff hω hi.le] at hx
    rw [mem_twoAdicDomain_iff hω hi, ← hsq, hx]
  · intro y hy
    simp only [twoAdicDomain, Finset.mem_image, Finset.mem_range] at hy
    obtain ⟨j, -, rfl⟩ := hy
    refine ⟨(ω ^ 2 ^ i) ^ j, ?_, ?_⟩
    · rw [mem_twoAdicDomain_iff hω hi.le, ← pow_mul, mul_comm, pow_mul,
        (Domain.isPrimitiveRoot_pow_two_pow hω hi.le).pow_eq_one, one_pow]
    · rw [pow_succ 2 i, pow_mul ω, pow_right_comm]

/-- The two-adic domains of `ω ^ 2 ^ (n - L)`, the generator of order `2 ^ L`,
are those of `ω` from level `n - L` on. -/
theorem twoAdicDomain_generator {L : ℕ} (hL : L ≤ n) (i : ℕ) :
    twoAdicDomain (ω ^ 2 ^ (n - L)) L i = twoAdicDomain ω n (n - L + i) := by
  have h : L - i = n - (n - L + i) := by omega
  rw [twoAdicDomain, twoAdicDomain, ← pow_mul, ← pow_add, h]

end TwoAdicDomain

/-- The low-degree test on the two-adic domains of `ω`, with `rounds` folding
rounds and a final polynomial of degree below `finalDegree`. The domain at
level `i` is `twoAdicDomain ω n i` and the degree bound is
`2 ^ (rounds - i) * finalDegree`.

In Plonky3 terms, with every arity two: `n = log_global_max_height`,
`ω = two_adic_generator(n)`, `rounds = n - (log_blowup + log_final_poly_len)` and
`finalDegree = 2 ^ log_final_poly_len`. -/
def twoAdicInstance [DecidableEq F] (ω : F) (n rounds finalDegree : ℕ)
    (hω : IsPrimitiveRoot ω (2 ^ n)) (hr : rounds ≤ n) : LdtInstance F where
  rounds := rounds
  domain i := twoAdicDomain ω n i
  degree i := 2 ^ (rounds - i) * finalDegree
  step i hi := squareStep_twoAdicDomain hω (lt_of_lt_of_le hi hr)
  degree_step i hi := by
    have h : rounds - i = rounds - (i + 1) + 1 := by omega
    rw [h, pow_succ]
    ring

section TwoAdicInstance

variable [DecidableEq F] (ω : F) (n rounds finalDegree : ℕ) (hω : IsPrimitiveRoot ω (2 ^ n))
  (hr : rounds ≤ n)

/-- The number of rounds of `twoAdicInstance`. -/
@[simp]
theorem twoAdicInstance_rounds : (twoAdicInstance ω n rounds finalDegree hω hr).rounds = rounds :=
  rfl

/-- The domains of `twoAdicInstance`. -/
@[simp]
theorem twoAdicInstance_domain (i : ℕ) :
    (twoAdicInstance ω n rounds finalDegree hω hr).domain i = twoAdicDomain ω n i :=
  rfl

/-- The degree bounds of `twoAdicInstance`. -/
@[simp]
theorem twoAdicInstance_degree (i : ℕ) :
    (twoAdicInstance ω n rounds finalDegree hω hr).degree i = 2 ^ (rounds - i) * finalDegree :=
  rfl

end TwoAdicInstance

/-! ## Query indices and domain points

Plonky3 stores a codeword of log-height `h` in bit-reversed order: position
`index` holds the value at `two_adic_generator(h) ^ reverse_bits_len(index, h)`.
The two children `2 * i` and `2 * i + 1` of position `i` at log-height `h` are
then a point and its negation, both squaring to the point of `i`. -/

/-- The domain point named by `index` at log-height `h`: Plonky3's
`two_adic_generator(h).exp_u64(reverse_bits_len(index, h))`, with `ω ^ 2 ^ (n - h)`
for `two_adic_generator(h)`.

This is the point at which `verify_fri` reads the codewords of a query: the
input matrices of log-height `h` in `open_inputs` (there multiplied by the
coset shift), and the committed fold of log-height `h` in `fold_query`. -/
def pointOfIndex (ω : F) (n h index : ℕ) : F := (ω ^ 2 ^ (n - h)) ^ reverseBitsLen index h

section PointOfIndex

variable {ω : F} {n : ℕ}

/-- There is one point at log-height zero. -/
@[simp]
theorem pointOfIndex_zero_height (ω : F) (n index : ℕ) : pointOfIndex ω n 0 index = 1 := by
  simp [pointOfIndex]

/-- Folding moves to the parent index: the square of the point of `index` at
log-height `h + 1` is the point of `index / 2` at log-height `h`. This is the
step `*start_index >>= log_arity` of Plonky3's `fold_query`, for arity two. -/
theorem pointOfIndex_sq (hω : IsPrimitiveRoot ω (2 ^ n)) {h : ℕ} (hh : h < n) (index : ℕ) :
    pointOfIndex ω n (h + 1) index ^ 2 = pointOfIndex ω n h (index / 2) := by
  have hn : 2 ^ n = 2 ^ (n - (h + 1)) * 2 ^ h * 2 := by
    rw [← pow_add, ← pow_succ]
    congr 1
    omega
  have hn' : 2 ^ (n - h) = 2 ^ (n - (h + 1)) * 2 := by
    rw [← pow_succ]
    congr 1
    omega
  have e : 2 ^ (n - (h + 1)) * ((index % 2 * 2 ^ h + reverseBitsLen (index / 2) h) * 2) =
      2 ^ n * (index % 2) + 2 ^ (n - h) * reverseBitsLen (index / 2) h := by
    rw [hn, hn']
    ring
  rw [pointOfIndex, pointOfIndex, Domain.reverseBitsLen_succ, ← pow_mul, ← pow_mul, ← pow_mul, e,
    pow_add, pow_mul, hω.pow_eq_one, one_pow, one_mul]

/-- The sibling is the negation: flipping the low bit of the index negates the
point. In `fold_query` the opened row holds the values at `index` and
`index ^^^ 1`. -/
theorem pointOfIndex_xor_one (hω : IsPrimitiveRoot ω (2 ^ n)) {h : ℕ} (hh : h < n) (index : ℕ) :
    pointOfIndex ω n (h + 1) (index ^^^ 1) = -pointOfIndex ω n (h + 1) index := by
  have hζ : (ω ^ 2 ^ (n - (h + 1))) ^ 2 ^ h = -1 := by
    rw [← pow_mul, ← pow_add, ← Domain.pow_two_pow_pred hω (by omega)]
    congr 2
    omega
  have hdiv : (index ^^^ 1) / 2 = index / 2 := by simp [Nat.xor_div_two]
  rw [pointOfIndex, pointOfIndex, Domain.reverseBitsLen_succ, Domain.reverseBitsLen_succ, hdiv,
    pow_add, pow_add, mul_comm _ (2 ^ h), mul_comm _ (2 ^ h), pow_mul, pow_mul, hζ]
  rcases Nat.mod_two_eq_zero_or_one index with h0 | h1
  · have e : index ^^^ 1 = index + 1 := Nat.xor_one_of_even (Nat.even_iff.mpr h0)
    have : (index ^^^ 1) % 2 = 1 := by omega
    rw [h0, this]
    ring
  · have e : index ^^^ 1 = index - 1 := Nat.xor_one_of_odd (Nat.odd_iff.mpr h1)
    have : (index ^^^ 1) % 2 = 0 := by omega
    rw [h1, this]
    ring

/-- Folding `k` times moves to the `k`-th ancestor: raising the point of `index`
at log-height `h` to the power `2 ^ k` gives the point of `index >>> k` at
log-height `h - k`. -/
theorem pointOfIndex_pow_two_pow (hω : IsPrimitiveRoot ω (2 ^ n)) {h k : ℕ} (hh : h ≤ n)
    (hk : k ≤ h) (index : ℕ) :
    pointOfIndex ω n h index ^ 2 ^ k = pointOfIndex ω n (h - k) (index >>> k) := by
  induction k with
  | zero => simp
  | succ k ih =>
    have e : h - k = h - (k + 1) + 1 := by omega
    rw [pow_succ, pow_mul, ih (by omega), e, pointOfIndex_sq hω (by omega), Nat.shiftRight_succ]

/-- The point an input of log-height `h` is read at. In `open_inputs`, a matrix of
log-height `h` below the global maximum `L` is read at `index >> (L - h)`, where
`index` is the query index at log-height `L`, and its point is
`two_adic_generator(h).exp_u64(reverse_bits_len(index >> (L - h), h))` times the
coset shift. Without the shift, this is the query point raised to the power
`2 ^ (L - h)`: the point the fold has reached when the input joins. -/
theorem pointOfIndex_shiftRight (hω : IsPrimitiveRoot ω (2 ^ n)) {h L : ℕ} (hhL : h ≤ L)
    (hL : L ≤ n) (index : ℕ) :
    pointOfIndex ω n h (index >>> (L - h)) = pointOfIndex ω n L index ^ 2 ^ (L - h) := by
  rw [pointOfIndex_pow_two_pow hω hL (Nat.sub_le L h), Nat.sub_sub_self hhL]

/-- The point of an index below `2 ^ h` does not depend on the log-height
`L ≥ h` it is read at. -/
theorem pointOfIndex_eq_of_lt {h L index : ℕ} (hhL : h ≤ L) (hL : L ≤ n)
    (hindex : index < 2 ^ h) : pointOfIndex ω n L index = pointOfIndex ω n h index := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hhL
  have e : n - h = n - (h + k) + k := by omega
  rw [pointOfIndex, pointOfIndex, Domain.reverseBitsLen_add_of_lt hindex, pow_mul, ← pow_mul ω,
    ← pow_add, ← e]

/-- The point of the final polynomial. After folding down to log-height `h`,
`verify_fri` evaluates the final polynomial at
`two_adic_generator(L).exp_u64(reverse_bits_len(domain_index, L))`, where `L` is
`log_global_max_height` and `domain_index < 2 ^ h`. That is the point of
`domain_index` at log-height `h`. -/
theorem finalPoint_eq_pointOfIndex {h L index : ℕ} (hhL : h ≤ L) (hL : L ≤ n)
    (hindex : index < 2 ^ h) :
    (ω ^ 2 ^ (n - L)) ^ reverseBitsLen index L = pointOfIndex ω n h index :=
  pointOfIndex_eq_of_lt hhL hL hindex

/-- The point of the final polynomial is the query point after all folds: with
`index < 2 ^ L` the query index and `h` the final log-height, `verify_fri`
evaluates the final polynomial at the query point raised to the power
`2 ^ (L - h)`. -/
theorem finalPoint_eq_pow (hω : IsPrimitiveRoot ω (2 ^ n)) {h L index : ℕ} (hhL : h ≤ L)
    (hL : L ≤ n) (hindex : index < 2 ^ L) :
    (ω ^ 2 ^ (n - L)) ^ reverseBitsLen (index >>> (L - h)) L =
      pointOfIndex ω n L index ^ 2 ^ (L - h) := by
  have hlt : index >>> (L - h) < 2 ^ h := by
    rw [Nat.shiftRight_eq_div_pow, Nat.div_lt_iff_lt_mul (by positivity), ← pow_add,
      Nat.add_sub_cancel' hhL]
    exact hindex
  rw [finalPoint_eq_pointOfIndex hhL hL hlt, pointOfIndex_shiftRight hω hhL hL]

/-- The first point `fold_row` interpolates through. With `index` the parent
index at log-height `h`, Plonky3's `fold_row` takes
`two_adic_generator(h + 1).exp_u64(reverse_bits_len(index, h))` as the point of
the first value of the row. It is the point of the left child `2 * index`. -/
theorem pointOfIndex_two_mul (ω : F) (n h index : ℕ) :
    pointOfIndex ω n (h + 1) (2 * index) = (ω ^ 2 ^ (n - (h + 1))) ^ reverseBitsLen index h := by
  rw [pointOfIndex, Domain.reverseBitsLen_two_mul]

/-- The second point `fold_row` interpolates through, the point of the right
child `2 * index + 1`, is the negation of the first. -/
theorem pointOfIndex_two_mul_add_one (hω : IsPrimitiveRoot ω (2 ^ n)) {h : ℕ} (hh : h < n)
    (index : ℕ) :
    pointOfIndex ω n (h + 1) (2 * index + 1) =
      -(ω ^ 2 ^ (n - (h + 1))) ^ reverseBitsLen index h := by
  have e : 2 * index + 1 = (2 * index) ^^^ 1 := (Nat.xor_one_of_even (even_two_mul index)).symm
  rw [e, pointOfIndex_xor_one hω hh, pointOfIndex_two_mul]

/-- The point of a bit-reversed index is the plain power of the generator. -/
theorem pointOfIndex_reverseBitsLen (hω : IsPrimitiveRoot ω (2 ^ n)) {h : ℕ} (hh : h ≤ n)
    (j : ℕ) : pointOfIndex ω n h (reverseBitsLen j h) = (ω ^ 2 ^ (n - h)) ^ j := by
  have hζ := Domain.isPrimitiveRoot_generator hω hh
  rw [pointOfIndex, Domain.reverseBitsLen_reverseBitsLen]
  conv_rhs => rw [← Nat.mod_add_div j (2 ^ h), pow_add, pow_mul, hζ.pow_eq_one, one_pow, mul_one]

/-- With compatible generators `g`, the point of `index` at log-height `h` is
`g h ^ reverseBitsLen index h`, as the verifier computes it. -/
theorem pointOfIndex_eq_generator_pow {g : ℕ → F} (hg : ∀ h < n, g (h + 1) ^ 2 = g h) {h : ℕ}
    (hh : h ≤ n) (index : ℕ) : pointOfIndex (g n) n h index = g h ^ reverseBitsLen index h := by
  rw [pointOfIndex, ← Domain.generator_eq_pow hg hh]

/-- The points at log-height `h` computed from `ω ^ 2 ^ (n - L)`, the generator of
order `2 ^ L`, are those computed from `ω`. -/
theorem pointOfIndex_generator {h L : ℕ} (hhL : h ≤ L) (hL : L ≤ n) (index : ℕ) :
    pointOfIndex (ω ^ 2 ^ (n - L)) L h index = pointOfIndex ω n h index := by
  have e : n - h = n - L + (L - h) := by omega
  rw [pointOfIndex, pointOfIndex, ← pow_mul ω (2 ^ (n - L)) (2 ^ (L - h)), ← pow_add, e]

/-- Distinct indices below `2 ^ h` name distinct points. -/
theorem pointOfIndex_inj (hω : IsPrimitiveRoot ω (2 ^ n)) {h : ℕ} (hh : h ≤ n) {i j : ℕ}
    (hi : i < 2 ^ h) (hj : j < 2 ^ h) :
    pointOfIndex ω n h i = pointOfIndex ω n h j ↔ i = j := by
  refine ⟨fun hij => ?_, fun hij => by rw [hij]⟩
  exact Domain.reverseBitsLen_inj hi hj
    ((Domain.isPrimitiveRoot_generator hω hh).pow_inj (Domain.reverseBitsLen_lt i h)
      (Domain.reverseBitsLen_lt j h) hij)

variable [DecidableEq F]

/-- The point of an index at log-height `h` lies in the subgroup of order `2 ^ h`,
which is the domain after `n - h` folds. -/
theorem pointOfIndex_mem_twoAdicDomain (hω : IsPrimitiveRoot ω (2 ^ n)) (h index : ℕ) :
    pointOfIndex ω n h index ∈ twoAdicDomain ω n (n - h) := by
  have e : 2 ^ (n - h) * 2 ^ (n - (n - h)) = 2 ^ n := by
    rw [← pow_add]
    congr 1
    omega
  rw [mem_twoAdicDomain_iff hω (Nat.sub_le n h), pointOfIndex,
    pow_right_comm (ω ^ 2 ^ (n - h)), ← pow_mul ω, e, hω.pow_eq_one, one_pow]

/-- The point of an index at log-height `n - i` lies in the domain after `i`
folds. -/
theorem pointOfIndex_mem_twoAdicDomain' (hω : IsPrimitiveRoot ω (2 ^ n)) {i : ℕ} (hi : i ≤ n)
    (index : ℕ) : pointOfIndex ω n (n - i) index ∈ twoAdicDomain ω n i := by
  simpa [Nat.sub_sub_self hi] using pointOfIndex_mem_twoAdicDomain hω (n - i) index

/-- Every point of the subgroup of order `2 ^ h` is named by an index below
`2 ^ h`. -/
theorem exists_pointOfIndex_eq (hω : IsPrimitiveRoot ω (2 ^ n)) {h : ℕ} (hh : h ≤ n) {x : F}
    (hx : x ∈ twoAdicDomain ω n (n - h)) : ∃ index < 2 ^ h, pointOfIndex ω n h index = x := by
  simp only [twoAdicDomain, Finset.mem_image, Finset.mem_range] at hx
  obtain ⟨j, -, rfl⟩ := hx
  exact ⟨reverseBitsLen j h, Domain.reverseBitsLen_lt j h, pointOfIndex_reverseBitsLen hω hh j⟩

/-- The points of the indices below `2 ^ h` are exactly the subgroup of order
`2 ^ h`. -/
theorem image_pointOfIndex (hω : IsPrimitiveRoot ω (2 ^ n)) {h : ℕ} (hh : h ≤ n) :
    (Finset.range (2 ^ h)).image (pointOfIndex ω n h) = twoAdicDomain ω n (n - h) := by
  ext x
  constructor
  · intro hx
    obtain ⟨index, -, rfl⟩ := Finset.mem_image.mp hx
    exact pointOfIndex_mem_twoAdicDomain hω h index
  · intro hx
    obtain ⟨index, hindex, rfl⟩ := exists_pointOfIndex_eq hω hh hx
    exact Finset.mem_image_of_mem _ (Finset.mem_range.mpr hindex)

/-- `pointOfIndex ω n h` is a bijection from the indices below `2 ^ h` onto the
subgroup of order `2 ^ h`. -/
theorem bijOn_pointOfIndex (hω : IsPrimitiveRoot ω (2 ^ n)) {h : ℕ} (hh : h ≤ n) :
    Set.BijOn (pointOfIndex ω n h) (Finset.range (2 ^ h)) (twoAdicDomain ω n (n - h)) := by
  refine ⟨fun index _ => pointOfIndex_mem_twoAdicDomain hω h index, fun i hi j hj hij => ?_,
    fun x hx => ?_⟩
  · exact (pointOfIndex_inj hω hh (Finset.mem_range.mp hi) (Finset.mem_range.mp hj)).mp hij
  · obtain ⟨index, hindex, rfl⟩ := exists_pointOfIndex_eq hω hh hx
    exact ⟨index, Finset.mem_range.mpr hindex, rfl⟩

/-- Counting indices is counting domain points: as many indices below `2 ^ h`
have a point satisfying `P` as there are points of the subgroup of order `2 ^ h`
satisfying `P`. A uniform query index is thus a uniform domain point. -/
theorem card_filter_pointOfIndex (hω : IsPrimitiveRoot ω (2 ^ n)) {h : ℕ} (hh : h ≤ n)
    (P : F → Prop) [DecidablePred P] :
    ((Finset.range (2 ^ h)).filter fun index => P (pointOfIndex ω n h index)).card =
      ((twoAdicDomain ω n (n - h)).filter P).card := by
  rw [← image_pointOfIndex hω hh, Finset.filter_image, Finset.card_image_of_injOn]
  exact (bijOn_pointOfIndex hω hh).injOn.mono (Finset.coe_subset.mpr (Finset.filter_subset _ _))

end PointOfIndex

/-! ## Cosets

Plonky3 commits to the evaluations of a polynomial on the coset `s * H` of a
two-adic subgroup `H` (`s` is `Val::GENERATOR` in `open_inputs`), and indexes
them by the points of `H`. A function `f` on the coset is thus handled as the
function `fun x => f (s * x)` on `H`. The two views have the same codewords. -/

namespace Domain

/-- Scaling the variable of a polynomial keeps its degree bound. -/
theorem degree_comp_C_mul_X_lt {p : F[X]} {d : ℕ} (hp : p.degree < d) (s : F) :
    (p.comp (C s * X)).degree < d := by
  rw [degree_lt_iff_coeff_zero] at hp ⊢
  intro m hm
  rw [comp_C_mul_X_coeff, hp m hm, zero_mul]

end Domain

section Coset

variable [DecidableEq F] {s : F}

/-- A function is a codeword on the scaled domain `s * D` exactly when its
reparametrization by `x ↦ s * x` is a codeword on `D`. -/
theorem isCodeword_image_mul (hs : s ≠ 0) (D : Finset F) (d : ℕ) (f : F → F) :
    IsCodeword (D.image (s * ·)) d f ↔ IsCodeword D d (fun x => f (s * x)) := by
  constructor
  · rintro ⟨p, hp, hf⟩
    refine ⟨p.comp (C s * X), Domain.degree_comp_C_mul_X_lt hp s, fun x hx => ?_⟩
    simpa using hf (s * x) (Finset.mem_image_of_mem _ hx)
  · rintro ⟨q, hq, hf⟩
    refine ⟨q.comp (C s⁻¹ * X), Domain.degree_comp_C_mul_X_lt hq s⁻¹, fun y hy => ?_⟩
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy
    simpa [inv_mul_cancel_left₀ hs] using hf x hx

/-- A function agrees with a codeword on a fraction `θ` of the scaled domain
`s * D` exactly when its reparametrization by `x ↦ s * x` does on `D`. -/
theorem closeToCode_image_mul (hs : s ≠ 0) (D : Finset F) (d : ℕ) (θ : ℝ) (f : F → F) :
    CloseToCode (D.image (s * ·)) d θ f ↔ CloseToCode D d θ (fun x => f (s * x)) := by
  have hinj : Function.Injective (s * · : F → F) := mul_right_injective₀ hs
  have hcard : (D.image (s * ·)).card = D.card := Finset.card_image_of_injective D hinj
  constructor
  · rintro ⟨p, hp, B, hB, hθ, hf⟩
    refine ⟨p.comp (C s * X), Domain.degree_comp_C_mul_X_lt hp s, D.filter (s * · ∈ B),
      Finset.filter_subset _ _, ?_, fun x hx => ?_⟩
    · have hBimage : (D.filter (s * · ∈ B)).image (s * ·) = B := by
        ext y
        simp only [Finset.mem_image, Finset.mem_filter]
        constructor
        · rintro ⟨x, ⟨-, hx⟩, rfl⟩
          exact hx
        · intro hy
          obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp (hB hy)
          exact ⟨x, ⟨hx, hy⟩, rfl⟩
      have hBcard : (D.filter (s * · ∈ B)).card = B.card :=
        (Finset.card_image_of_injective _ hinj).symm.trans (congrArg Finset.card hBimage)
      rw [hBcard, ← hcard]
      exact hθ
    · simpa using hf (s * x) (Finset.mem_filter.mp hx).2
  · rintro ⟨q, hq, B, hB, hθ, hf⟩
    refine ⟨q.comp (C s⁻¹ * X), Domain.degree_comp_C_mul_X_lt hq s⁻¹, B.image (s * ·),
      Finset.image_subset_image hB, ?_, fun y hy => ?_⟩
    · rw [hcard, Finset.card_image_of_injective B hinj]
      exact hθ
    · obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy
      simpa [inv_mul_cancel_left₀ hs] using hf x hx

end Coset

end CertiFri
