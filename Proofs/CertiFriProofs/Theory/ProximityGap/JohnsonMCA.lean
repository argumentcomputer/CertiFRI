import CertiFriProofs.Theory.ProximityGap.Johnson
import CertiFriProofs.Theory.StepMCA

/-!
# Mutual correlated agreement up to the Johnson radius, via list-decoding peeling

The soundness theorems of CertiFRI consume `CurveMCA` (batching) and `StepMCA`
(folding). Beyond the unique-decoding radius `(1 - ρ) / 2`, a received word
within relative distance `δ < 1 - √ρ` (agreement `θ > √ρ`) is no longer
uniquely decodable, so `CurveCA` (which asks for a single correlated tuple)
does not suffice. Instead, the interleaved Johnson bound
(`ProximityGap/Johnson.lean`) guarantees that at most
`L_J = johnsonListBound |D| d A ≤ (θ - ρ) / (θ ^ 2 - ρ)` correlated tuples
can exist.

This file defines `CurveListCA F T` — the list-decoding correlated-agreement
peeling property in the Johnson regime (BCIKS20 Theorem 6.2 / BCHKS25 / DKT26) —
and proves **unconditionally** that `CurveListCA F T` implies both `CurveMCA`
and `StepMCA` up to the full Johnson radius `θ > √ρ`:

* `CurveListCA F T`: if more than `T |D| d A m` values of `β` admit a degree-`< d`
  polynomial agreeing with `∑ k, β ^ k * u k` on at least `A` points of `D` that
  is *not* generated by the already-peeled list `L`, then there exists a new
  correlated `m`-tuple `v ∉ L` agreeing with `u` on at least `A` points of `D`.
* `curve_mca_of_curveListCA`: peeling induction bounded by
  `card_correlatedTuples_le_johnson` builds a complete correlated list `L` of size
  at most `L_J`, leaving at most `T |D| d A m` uncovered parameters and at most
  `L_J * (|D| - A) * (m - 1)` spurious cancellation parameters.
* `curveMCA_of_curveListCA_rel`, `curveMCA_of_curveListCA_of_card_le`: `CurveMCA`
  at any agreement `θ` with `ρ < θ ^ 2`, `0 < θ ≤ 1`, with error
  `(T_bound + ((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * |D|) * (m - 1)) / |F|`.
* `stepMCA_of_curveListCA_rel`, `stepMCA_of_curveListCA_of_card_le`: `StepMCA`
  for folding rounds at the same Johnson agreement `θ > √ρ`.

## What is assumed

`CurveListCA F T` is a hypothesis of the theorems in this file. The algebraic
list-decoding core (weighted degree, characteristic-free Hasse derivatives,
multiplicity divisibility, Guruswami–Sudan root theorem, and existence of the
parametric interpolation polynomial over `RatFunc F`) is proved unconditionally
in `ProximityGap/GuruswamiSudan.lean`. Discharging `CurveListCA F T` itself
remains the single remaining algebraic bridge (separability/Frobenius stripping,
Hensel lifting into `F(X)[[Z - z₀]]`, and BCIKS Lemma 5.5–5.6 power-series
rationality / BCHKS25–DKT26 curve analysis).
-/

namespace CertiFri

open Polynomial Finset

section ListCA

/-- **List-decoding correlated agreement (peeling step) in the Johnson regime.**

For every domain `D`, degree bound `d`, agreement count `A` strictly above the
Johnson radius (`D.card * (d - 1) < A ^ 2`), curve length `m`, words
`u 0, …, u (m - 1)`, and finite list `L` of already-known correlated `m`-tuples
agreeing with `u` on at least `A` points of `D`: if for more than
`T D.card d A m` values of `β`, the curve combination `∑ k, β ^ k * u k` agrees
on at least `A` points of `D` with some polynomial `p` of degree below `d` that
is *not* `∑ k, β ^ k • v k` for any `v ∈ L`, then there exists a new correlated
tuple `v ∉ L` of degree-`< d` polynomials agreeing with `u` on at least `A`
points of `D`. -/
def CurveListCA (F : Type*) [Field F] [DecidableEq F] (T : ℕ → ℕ → ℕ → ℕ → ℕ) : Prop :=
  ∀ (D : Finset F) (d A m : ℕ), D.card * (d - 1) < A ^ 2 →
    ∀ (u : Fin m → F → F) (L : Finset (Fin m → F[X])) (G : Finset F),
      (∀ v ∈ L, (∀ k, (v k).degree < d) ∧ A ≤ (tupleAgreeSet D u v).card) →
      T D.card d A m < G.card →
      (∀ β ∈ G, ∃ p : F[X], p.degree < d ∧
        (∀ v ∈ L, p ≠ ∑ k : Fin m, β ^ (k : ℕ) • v k) ∧
        A ≤ (D.filter fun x => ∑ k : Fin m, β ^ (k : ℕ) * u k x = p.eval x).card) →
      ∃ v : Fin m → F[X], v ∉ L ∧ (∀ k, (v k).degree < d) ∧
        A ≤ (tupleAgreeSet D u v).card

end ListCA

section Peeling

variable {F : Type*} [Field F] [DecidableEq F] [Fintype F]

/-- The set of parameters `β` admitting a degree-`< d` polynomial close to
`∑ k, β ^ k * u k` that is not generated by any correlated tuple in `L`. -/
private noncomputable def uncoveredParams (D : Finset F) (d A m : ℕ)
    (u : Fin m → F → F) (L : Finset (Fin m → F[X])) : Finset F := by
  classical
  exact univ.filter fun β => ∃ p : F[X], p.degree < d ∧
    (∀ v ∈ L, p ≠ ∑ k : Fin m, β ^ (k : ℕ) • v k) ∧
    A ≤ (D.filter fun x => ∑ k : Fin m, β ^ (k : ℕ) * u k x = p.eval x).card

/-- Peeling induction: starting from any list `L` of correlated tuples with
`johnsonListBound D.card d A - L.card ≤ k`, extend `L` until the uncovered
parameter set has size at most `T D.card d A m`. -/
private theorem exists_peeled_list {T : ℕ → ℕ → ℕ → ℕ → ℕ} (hca : CurveListCA F T)
    (D : Finset F) (d A m : ℕ) (hJ : D.card * (d - 1) < A ^ 2) (u : Fin m → F → F) :
    ∀ (k : ℕ) (L : Finset (Fin m → F[X])),
      (∀ v ∈ L, (∀ j, (v j).degree < d) ∧ A ≤ (tupleAgreeSet D u v).card) →
      johnsonListBound D.card d A - L.card ≤ k →
      ∃ L' : Finset (Fin m → F[X]),
        (∀ v ∈ L', (∀ j, (v j).degree < d) ∧ A ≤ (tupleAgreeSet D u v).card) ∧
        L'.card ≤ johnsonListBound D.card d A ∧
        (uncoveredParams D d A m u L').card ≤ T D.card d A m := by
  classical
  intro k
  induction k with
  | zero =>
    intro L hL hrem
    have hLbound : L.card ≤ johnsonListBound D.card d A :=
      card_correlatedTuples_le_johnson hJ (fun v hv => (hL v hv).1) (fun v hv => (hL v hv).2)
    by_cases hG : (uncoveredParams D d A m u L).card ≤ T D.card d A m
    · exact ⟨L, hL, hLbound, hG⟩
    · obtain ⟨v, hv_not, hv_deg, hv_ag⟩ :=
        hca D d A m hJ u L (uncoveredParams D d A m u L) hL (not_le.mp hG) fun β hβ => by
          simpa [uncoveredParams] using hβ
      have hL1 : ∀ w ∈ insert v L, (∀ j, (w j).degree < d) ∧ A ≤ (tupleAgreeSet D u w).card := by
        intro w hw
        rcases mem_insert.mp hw with rfl | hwL
        · exact ⟨hv_deg, hv_ag⟩
        · exact hL w hwL
      have hL1bound : (insert v L).card ≤ johnsonListBound D.card d A :=
        card_correlatedTuples_le_johnson hJ (fun w hw => (hL1 w hw).1) (fun w hw => (hL1 w hw).2)
      rw [card_insert_of_notMem hv_not] at hL1bound
      omega
  | succ k ih =>
    intro L hL hrem
    have hLbound : L.card ≤ johnsonListBound D.card d A :=
      card_correlatedTuples_le_johnson hJ (fun v hv => (hL v hv).1) (fun v hv => (hL v hv).2)
    by_cases hG : (uncoveredParams D d A m u L).card ≤ T D.card d A m
    · exact ⟨L, hL, hLbound, hG⟩
    · obtain ⟨v, hv_not, hv_deg, hv_ag⟩ :=
        hca D d A m hJ u L (uncoveredParams D d A m u L) hL (not_le.mp hG) fun β hβ => by
          simpa [uncoveredParams] using hβ
      have hL1 : ∀ w ∈ insert v L, (∀ j, (w j).degree < d) ∧ A ≤ (tupleAgreeSet D u w).card := by
        intro w hw
        rcases mem_insert.mp hw with rfl | hwL
        · exact ⟨hv_deg, hv_ag⟩
        · exact hL w hwL
      have hcard1 : (insert v L).card = L.card + 1 := card_insert_of_notMem hv_not
      exact ih (insert v L) hL1 (by omega)

/-- **Mutual correlated agreement in the Johnson regime, from `CurveListCA`.**

Let `D.card * (d - 1) < A ^ 2`. Under `CurveListCA F T`, for every choice of
words `u : Fin m → F → F`, there is an exceptional set `bad` of size at most
`T D.card d A m + johnsonListBound D.card d A * ((D.card - A) * (m - 1))`
outside which every degree-`< d` polynomial agreeing with `∑ k, β ^ k * u k`
on a subset `B ⊆ D` of size at least `A` yields a correlated tuple `v` agreeing
with every `u k` on that exact same `B`. -/
theorem curve_mca_of_curveListCA {T : ℕ → ℕ → ℕ → ℕ → ℕ} (hca : CurveListCA F T)
    (D : Finset F) (d A m : ℕ) (hJ : D.card * (d - 1) < A ^ 2) (u : Fin m → F → F) :
    ∃ bad : Finset F,
      bad.card ≤ T D.card d A m + johnsonListBound D.card d A * ((D.card - A) * (m - 1)) ∧
      ∀ β ∉ bad, ∀ p : F[X], p.degree < d → ∀ B ⊆ D, A ≤ B.card →
        (∀ x ∈ B, ∑ k : Fin m, β ^ (k : ℕ) * u k x = p.eval x) →
        ∃ v : Fin m → F[X], (∀ k, (v k).degree < d) ∧ ∀ k, ∀ x ∈ B, u k x = (v k).eval x := by
  classical
  obtain ⟨L, hL, hLcard, hGcard⟩ :=
    exists_peeled_list hca D d A m hJ u (johnsonListBound D.card d A) ∅
      (by simp) (by simp)
  let badOf : (Fin m → F[X]) → Finset F := fun v =>
    (D.filter fun x => ∃ k, u k x ≠ (v k).eval x).biUnion fun x =>
      univ.filter fun β => ∑ k : Fin m, β ^ (k : ℕ) * (u k x - (v k).eval x) = 0
  let bad : Finset F := uncoveredParams D d A m u L ∪ L.biUnion badOf
  have hbadOf_card : ∀ v ∈ L, (badOf v).card ≤ (D.card - A) * (m - 1) := by
    intro v hv
    have herr_card : (D.filter fun x => ∃ k, u k x ≠ (v k).eval x).card ≤ D.card - A := by
      have hsplit := card_filter_add_card_filter_not (s := D)
        (fun x => ∀ k : Fin m, u k x = (v k).eval x)
      have hcompl : (D.filter fun x => ∃ k, u k x ≠ (v k).eval x) =
          (D.filter fun x => ¬∀ k : Fin m, u k x = (v k).eval x) := by
        ext x
        simp only [mem_filter, not_forall]
      rw [hcompl]
      have hag := (hL v hv).2
      rw [tupleAgreeSet] at hag
      omega
    calc (badOf v).card
        ≤ ∑ x ∈ D.filter fun x => ∃ k, u k x ≠ (v k).eval x,
            (univ.filter fun β =>
              ∑ k : Fin m, β ^ (k : ℕ) * (u k x - (v k).eval x) = 0).card :=
          card_biUnion_le
      _ ≤ ∑ _x ∈ D.filter fun x => ∃ k, u k x ≠ (v k).eval x, (m - 1) :=
          sum_le_sum fun x hx => by
            have ha : (fun k => u k x - (v k).eval x) ≠ 0 := by
              obtain ⟨k, hk⟩ := (mem_filter.mp hx).2
              exact fun h0 => hk (sub_eq_zero.mp (congrFun h0 k))
            have := ProximityGap.card_roots_lt ha univ
            omega
      _ = (D.filter fun x => ∃ k, u k x ≠ (v k).eval x).card * (m - 1) := by simp
      _ ≤ (D.card - A) * (m - 1) := Nat.mul_le_mul_right _ herr_card
  refine ⟨bad, ?_, ?_⟩
  · calc bad.card
        ≤ (uncoveredParams D d A m u L).card + (L.biUnion badOf).card := card_union_le _ _
      _ ≤ T D.card d A m + ∑ v ∈ L, (badOf v).card := Nat.add_le_add hGcard card_biUnion_le
      _ ≤ T D.card d A m + ∑ _v ∈ L, ((D.card - A) * (m - 1)) :=
          Nat.add_le_add_left (sum_le_sum hbadOf_card) _
      _ = T D.card d A m + L.card * ((D.card - A) * (m - 1)) := by simp
      _ ≤ T D.card d A m + johnsonListBound D.card d A * ((D.card - A) * (m - 1)) :=
          Nat.add_le_add_left (Nat.mul_le_mul_right _ hLcard) _
  · intro β hβ p hp B hBD hB hagree
    have hnotUncov : β ∉ uncoveredParams D d A m u L := fun h => hβ (mem_union_left _ h)
    have hnotBadOf : ∀ v ∈ L, β ∉ badOf v := fun v hv h =>
      hβ (mem_union_right _ (mem_biUnion.mpr ⟨v, hv, h⟩))
    have hfilter_ge : A ≤ (D.filter fun x => ∑ k : Fin m, β ^ (k : ℕ) * u k x = p.eval x).card := by
      refine hB.trans (card_le_card fun x hx => mem_filter.mpr ⟨hBD hx, hagree x hx⟩)
    have hex_v : ∃ v ∈ L, p = ∑ k : Fin m, β ^ (k : ℕ) • v k := by
      by_contra hnone
      push Not at hnone
      refine hnotUncov ?_
      simp only [uncoveredParams, mem_filter, mem_univ, true_and]
      exact ⟨p, hp, hnone, hfilter_ge⟩
    obtain ⟨v, hvL, hpv⟩ := hex_v
    refine ⟨v, (hL v hvL).1, fun k x hx => ?_⟩
    by_contra hne
    refine hnotBadOf v hvL (mem_biUnion.mpr ⟨x, mem_filter.mpr ⟨hBD hx, k, hne⟩,
      mem_filter.mpr ⟨mem_univ _, ?_⟩⟩)
    have hx' := hagree x hx
    rw [hpv, eval_finsetSum] at hx'
    simp only [mul_sub, sum_sub_distrib, hx', eval_smul, smul_eq_mul, sub_self]

/-! ## `CurveMCA` and `StepMCA` in relative Johnson parameters -/

/-- **`CurveMCA` in the Johnson regime, in relative terms.**

Assume `CurveListCA F T`. Let `0 < θ ≤ 1`, `ρ < θ ^ 2`, `(d : ℝ) ≤ ρ * D.card`,
and let `T_bound ≥ 0` upper-bound `T D.card d ⌈θ * D.card⌉₊ m`. Then
`CurveMCA D d m θ` holds with error
`(T_bound + ((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * D.card) * (m - 1)) / |F|`. -/
theorem curveMCA_of_curveListCA_rel {T : ℕ → ℕ → ℕ → ℕ → ℕ} (hca : CurveListCA F T)
    (D : Finset F) (d m : ℕ) {ρ θ T_bound : ℝ}
    (hθ0 : 0 < θ) (hθ1 : θ ≤ 1) (hd : (d : ℝ) ≤ ρ * D.card) (hgap : ρ < θ ^ 2)
    (hT0 : 0 ≤ T_bound) (hT : (T D.card d ⌈θ * D.card⌉₊ m : ℝ) ≤ T_bound) :
    CurveMCA D d m θ
      ((T_bound + ((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * D.card) * ((m - 1 : ℕ) : ℝ)) /
        Fintype.card F) := by
  have hF : (Fintype.card F : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  rcases D.eq_empty_or_nonempty with rfl | hDne
  · intro u
    refine ⟨∅, ?_, fun β _ p _ B hBD _ _ => ?_⟩
    · simp only [card_empty, Nat.cast_zero, mul_zero, zero_mul, add_zero]
      rw [div_mul_cancel₀ _ hF]
      exact hT0
    · refine ⟨fun _ => 0, fun _ => by rw [degree_zero]; exact WithBot.bot_lt_coe d, fun k x hx => ?_⟩
      exact absurd (hBD hx) (notMem_empty x)
  · intro u
    let A : ℕ := ⌈θ * D.card⌉₊
    have hDpos : 0 < D.card := hDne.card_pos
    have hDposR : (0 : ℝ) < D.card := Nat.cast_pos.mpr hDpos
    have hDsq : (0 : ℝ) < (D.card : ℝ) ^ 2 := sq_pos_of_pos hDposR
    have hA : θ * D.card ≤ (A : ℝ) := Nat.le_ceil _
    have hJ : D.card * (d - 1) < A ^ 2 := by
      have hk : ((d - 1 : ℕ) : ℝ) ≤ ρ * D.card := by
        have : ((d - 1 : ℕ) : ℝ) ≤ (d : ℝ) := Nat.cast_le.mpr (Nat.sub_le d 1)
        linarith
      have h1 : (D.card : ℝ) * ((d - 1 : ℕ) : ℝ) ≤ ρ * (D.card : ℝ) ^ 2 := by nlinarith
      have h2 : ρ * (D.card : ℝ) ^ 2 < θ ^ 2 * (D.card : ℝ) ^ 2 :=
        mul_lt_mul_of_pos_right hgap hDsq
      have h3 : θ ^ 2 * (D.card : ℝ) ^ 2 ≤ (A : ℝ) ^ 2 := by
        rw [← mul_pow]
        exact pow_le_pow_left₀ (by positivity) hA 2
      have h4 : (D.card : ℝ) * ((d - 1 : ℕ) : ℝ) < (A : ℝ) ^ 2 := by linarith
      exact_mod_cast h4
    obtain ⟨bad, hbad, hgood⟩ := curve_mca_of_curveListCA hca D d A m hJ u
    refine ⟨bad, ?_, fun β hβ p hp B hBD hB hagree =>
      hgood β hβ p hp B hBD (Nat.ceil_le.mpr hB) hagree⟩
    rw [div_mul_cancel₀ _ hF]
    have hbadR : (bad.card : ℝ) ≤ (T D.card d A m : ℝ) +
        (johnsonListBound D.card d A : ℝ) * (((D.card - A : ℕ) : ℝ) * ((m - 1 : ℕ) : ℝ)) := by
      exact_mod_cast hbad
    have hLle : (johnsonListBound D.card d A : ℝ) ≤ (θ - ρ) / (θ ^ 2 - ρ) :=
      johnsonListBound_le_rel hDpos hθ0 hθ1 hd hgap hA
    have hsub_le : ((D.card - A : ℕ) : ℝ) ≤ (1 - θ) * D.card := by
      by_cases hAD : A ≤ D.card
      · rw [Nat.cast_sub hAD]
        linarith
      · have hzero : D.card - A = 0 := Nat.sub_eq_zero_of_le (Nat.le_of_not_ge hAD)
        rw [hzero, Nat.cast_zero]
        have : 0 ≤ 1 - θ := sub_nonneg.mpr hθ1
        positivity
    have hLnn : (0 : ℝ) ≤ (θ - ρ) / (θ ^ 2 - ρ) := by
      have hden : 0 < θ ^ 2 - ρ := sub_pos.mpr hgap
      have hnum : 0 ≤ θ - ρ := by nlinarith
      exact div_nonneg hnum hden.le
    have hprod_le :
        (johnsonListBound D.card d A : ℝ) * (((D.card - A : ℕ) : ℝ) * ((m - 1 : ℕ) : ℝ)) ≤
        ((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * D.card) * ((m - 1 : ℕ) : ℝ) := by
      rw [mul_assoc]
      refine mul_le_mul hLle ?_ (by positivity) hLnn
      exact mul_le_mul_of_nonneg_right hsub_le (Nat.cast_nonneg _)
    linarith

/-- **`CurveMCA` in the Johnson regime, with domain size bounded by `N`.** -/
theorem curveMCA_of_curveListCA_of_card_le {T : ℕ → ℕ → ℕ → ℕ → ℕ} (hca : CurveListCA F T)
    (D : Finset F) (d m : ℕ) {ρ θ T_bound N : ℝ}
    (hθ0 : 0 < θ) (hθ1 : θ ≤ 1) (hd : (d : ℝ) ≤ ρ * D.card) (hgap : ρ < θ ^ 2)
    (hT0 : 0 ≤ T_bound) (hT : (T D.card d ⌈θ * D.card⌉₊ m : ℝ) ≤ T_bound)
    (hN : (D.card : ℝ) ≤ N) :
    CurveMCA D d m θ
      ((T_bound + ((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * N) * ((m - 1 : ℕ) : ℝ)) /
        Fintype.card F) := by
  refine ProximityGap.curveMCA_mono
    (curveMCA_of_curveListCA_rel hca D d m hθ0 hθ1 hd hgap hT0 hT) le_rfl ?_
  have hden : 0 < θ ^ 2 - ρ := sub_pos.mpr hgap
  have hLnn : 0 ≤ (θ - ρ) / (θ ^ 2 - ρ) := div_nonneg (by nlinarith) hden.le
  have h1θ : 0 ≤ 1 - θ := sub_nonneg.mpr hθ1
  gcongr

/-- **`StepMCA` in the Johnson regime, for a folding round into `D'`.** -/
theorem stepMCA_of_curveListCA_rel {T : ℕ → ℕ → ℕ → ℕ → ℕ} (hca : CurveListCA F T)
    {D D' : Finset F} (hstep : SquareStep D D') (d' : ℕ) {ρ θ T_bound : ℝ}
    (hθ0 : 0 < θ) (hθ1 : θ ≤ 1) (hd : (d' : ℝ) ≤ ρ * D'.card) (hgap : ρ < θ ^ 2)
    (hT0 : 0 ≤ T_bound) (hT : (T D'.card d' ⌈θ * D'.card⌉₊ 3 : ℝ) ≤ T_bound) :
    StepMCA D D' d' θ
      ((T_bound + 2 * (((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * D'.card))) / Fintype.card F) := by
  have h := curveMCA_of_curveListCA_rel hca D' d' 3 hθ0 hθ1 hd hgap hT0 hT
  have heq :
      (T_bound + ((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * D'.card) * (((3 - 1 : ℕ) : ℝ))) /
        Fintype.card F =
      (T_bound + 2 * (((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * D'.card))) / Fintype.card F := by
    norm_num
    ring
  rw [heq] at h
  exact StepMCA.of_curveMCA hstep h

/-- **`StepMCA` in the Johnson regime, with target domain size bounded by `N`.** -/
theorem stepMCA_of_curveListCA_of_card_le {T : ℕ → ℕ → ℕ → ℕ → ℕ} (hca : CurveListCA F T)
    {D D' : Finset F} (hstep : SquareStep D D') (d' : ℕ) {ρ θ T_bound N : ℝ}
    (hθ0 : 0 < θ) (hθ1 : θ ≤ 1) (hd : (d' : ℝ) ≤ ρ * D'.card) (hgap : ρ < θ ^ 2)
    (hT0 : 0 ≤ T_bound) (hT : (T D'.card d' ⌈θ * D'.card⌉₊ 3 : ℝ) ≤ T_bound)
    (hN : (D'.card : ℝ) ≤ N) :
    StepMCA D D' d' θ
      ((T_bound + 2 * (((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * N))) / Fintype.card F) := by
  have h := curveMCA_of_curveListCA_of_card_le hca D' d' 3 hθ0 hθ1 hd hgap hT0 hT hN
  have heq :
      (T_bound + ((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * N) * (((3 - 1 : ℕ) : ℝ))) /
        Fintype.card F =
      (T_bound + 2 * (((θ - ρ) / (θ ^ 2 - ρ)) * ((1 - θ) * N))) / Fintype.card F := by
    norm_num
    ring
  rw [heq] at h
  exact StepMCA.of_curveMCA hstep h

end Peeling

end CertiFri
