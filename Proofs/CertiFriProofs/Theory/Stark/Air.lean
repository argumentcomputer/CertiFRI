import Mathlib
import CertiFri.Stark.System
import CertiFriProofs.Theory.Stark.Graph
import CertiFriProofs.Theory.Stark.Logup
import CertiFriProofs.Theory.Stark.LogupDegree
import CertiFriProofs.Theory.Stark.Balance

/-!
# The constraints of one circuit, as polynomials

A circuit constrains the rows of its traces: the zeros of its graph and its
lookup constraints must vanish on every row. When each column is a polynomial,
a constraint is a polynomial too, which must vanish on the trace domain. The
verifier checks this at one random point `ζ`, after folding the constraints
with a random `α`, against a quotient the prover committed to.

This file defines these polynomials for one circuit and proves the two
counting bounds the protocol rests on, and what vanishing constraints say
about the lookup sum of the circuit.

## Contents

* `constraintVals`: the constraint values of a circuit on a row, over any
  commutative ring: the zeros of the graph, then the lookup constraints.
  `map_constraintVals`: ring homomorphisms commute with it.
* `foldAlpha α vals`: the fold with `α`, first value at the highest power.
  `fractionLE_foldAlpha`: values that are not all zero fold to zero for at most
  a fraction `(count - 1) / |K|` of the `α`.
* `Columns`, `polyRow`, `pointRow`: the columns of a circuit as polynomials,
  the row of polynomials the constraints are evaluated on, and its value at a
  point. `mapRow_eval_polyRow` relates the two. The selectors are those of
  Plonky3 for a subgroup of order `n` generated by `g`, as polynomials:
  `∑ i < n, X^i`, `g * ∑ i < n, (g * X)^i` and `X - g⁻¹`.
* `selector_first`, `selector_last`: the selectors at a point outside the
  domain, in the form the verifier computes them. `selector_first_pow`,
  `selector_last_pow`: their values on the rows of the domain.
* `compPoly`, `quotientPoly`: the folded constraints and the quotient
  reassembled from its chunks, as polynomials. `eval_compPoly`,
  `eval_quotientPoly`: their values at a point.
* `Circuit.zetaDegree`, `natDegree_compPoly_sub_le`: a bound on the degree of
  `compPoly - (X^n - 1) * quotientPoly`.
* `fractionLE_zeta`: if the folded constraints do not vanish at some point of
  the trace domain, the check at `ζ` passes for at most a fraction
  `zetaDegree / |K|` of the `ζ`.
* `circuitItems`, `logup_circuit_eq`: the messages a circuit sends on the rows
  of its trace, and the lookup sum of a circuit whose lookup constraints vanish
  on every row.

Nothing here is about a protocol or a commitment.
-/

namespace CertiFri.Stark.Model

open Polynomial CertiFri.Oracle

variable {F R S : Type}

section Ring

variable [CommRing R] [CommRing S]

/-- The constraint values of a circuit on a row: the values of the zeros of
its graph, then the lookup constraints. `ι` reads the constants of the graph,
`d` is the degree of the extension and `table` holds the structure constants of
its basis; `deltaScaled` holds the coordinates of the difference between the
lookup sums leaving and entering the circuit, divided by the value the last-row
selector takes on the last row. -/
def constraintVals (ι : F → R) (d : ℕ) (table : Array R) (c : Circuit F) (v : RowValues R)
    (deltaScaled : Array R) : Array R :=
  (c.graph.zeros.map fun z => (sweep ι c.graph.nodes v).getD z 0)
    ++ logupValues d table c.graph.lookups (sweep ι c.graph.nodes v) v.stage2 v.stage2Next
      v.publics deltaScaled v.isLastRow c.lookupGroupSize

/-- A ring homomorphism commutes with the constraint values. -/
theorem map_constraintVals (φ : R →+* S) (ι : F → R) (d : ℕ) (table : Array R) (c : Circuit F)
    (v : RowValues R) (deltaScaled : Array R) :
    (constraintVals ι d table c v deltaScaled).map φ =
      constraintVals (fun a => φ (ι a)) d (table.map φ) c (mapRow φ v) (deltaScaled.map φ) := by
  rw [constraintVals, constraintVals, Array.map_append, Array.map_map, map_logupValues,
    map_sweep]
  congr 2
  funext z
  exact (getD_sweep_mapRow φ ι c.graph.nodes v z).symm

/-- The number of constraint values: one per zero and `d` per group of
lookups. -/
theorem size_constraintVals (ι : F → R) (d : ℕ) (table : Array R) (c : Circuit F)
    (v : RowValues R) (deltaScaled : Array R) :
    (constraintVals ι d table c v deltaScaled).size =
      c.graph.zeros.size + lookupGroups c.graph.lookups.size c.lookupGroupSize * d := by
  rw [constraintVals, Array.size_append, Array.size_map, size_logupValues]

/-- The first constraint values are the zeros of the graph. -/
theorem getD_constraintVals_zero (ι : F → R) (d : ℕ) (table : Array R) (c : Circuit F)
    (v : RowValues R) (deltaScaled : Array R) {i : ℕ} (hi : i < c.graph.zeros.size) :
    (constraintVals ι d table c v deltaScaled).getD i 0 =
      (sweep ι c.graph.nodes v).getD (c.graph.zeros.getD i 0) 0 := by
  rw [constraintVals, Array.getD_eq_getD_getElem?,
    Array.getElem?_append_left (by rw [Array.size_map]; exact hi), Array.getElem?_map,
    Array.getD_eq_getD_getElem? (xs := c.graph.zeros), Array.getElem?_eq_getElem hi]
  rfl

/-- The constraint values after the zeros are the lookup constraints. -/
theorem getD_constraintVals_logup (ι : F → R) (d : ℕ) (table : Array R) (c : Circuit F)
    (v : RowValues R) (deltaScaled : Array R) (i : ℕ) :
    (constraintVals ι d table c v deltaScaled).getD (c.graph.zeros.size + i) 0 =
      (logupValues d table c.graph.lookups (sweep ι c.graph.nodes v) v.stage2 v.stage2Next
        v.publics deltaScaled v.isLastRow c.lookupGroupSize).getD i 0 := by
  rw [constraintVals, Array.getD_eq_getD_getElem?,
    Array.getElem?_append_right (by rw [Array.size_map]; exact Nat.le_add_right _ _),
    Array.size_map, Nat.add_sub_cancel_left, ← Array.getD_eq_getD_getElem?]

/-- The fold of constraint values with `α`: the first value at the highest
power. -/
def foldAlpha (α : R) (vals : Array R) : R :=
  vals.foldl (fun acc v => acc * α + v) 0

/-- `map_foldAlpha`, for the fold over a list from any value. -/
private theorem map_foldl_alpha (φ : R →+* S) (α : R) (l : List R) (a : R) :
    φ (l.foldl (fun acc v => acc * α + v) a) =
      (l.map φ).foldl (fun acc v => acc * φ α + v) (φ a) := by
  induction l generalizing a with
  | nil => rfl
  | cons x l ih => rw [List.foldl_cons, ih, List.map_cons, List.foldl_cons, map_add, map_mul]

/-- A ring homomorphism commutes with the fold. -/
theorem map_foldAlpha (φ : R →+* S) (α : R) (vals : Array R) :
    φ (foldAlpha α vals) = foldAlpha (φ α) (vals.map φ) := by
  rw [foldAlpha, foldAlpha, ← Array.foldl_toList, ← Array.foldl_toList, Array.toList_map,
    map_foldl_alpha, map_zero]

/-- `foldAlpha_eq_sum`, for the fold over a list from any value `a`, which
ends up at the power `α ^ length`. -/
private theorem foldl_alpha_eq_sum (α : R) (l : List R) (a : R) :
    l.foldl (fun acc v => acc * α + v) a =
      a * α ^ l.length + ∑ i ∈ Finset.range l.length, l.getD i 0 * α ^ (l.length - 1 - i) := by
  induction l generalizing a with
  | nil =>
    rw [List.foldl_nil, List.length_nil, pow_zero, mul_one, Finset.range_zero, Finset.sum_empty,
      add_zero]
  | cons x l ih =>
    rw [List.foldl_cons, ih, List.length_cons, Finset.sum_range_succ']
    simp only [List.getD_cons_succ, List.getD_cons_zero, Nat.add_sub_cancel, Nat.sub_zero,
      Nat.sub_sub, Nat.add_comm 1]
    ring

/-- The fold is `∑ i, vals[i] * α ^ (size - 1 - i)`. -/
theorem foldAlpha_eq_sum (α : R) (vals : Array R) :
    foldAlpha α vals = ∑ i ∈ Finset.range vals.size, vals.getD i 0 * α ^ (vals.size - 1 - i) := by
  rw [foldAlpha, ← Array.foldl_toList, foldl_alpha_eq_sum, zero_mul, zero_add,
    Array.length_toList]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [List.getD_eq_getElem?_getD, Array.getElem?_toList, Array.getD_eq_getD_getElem?]

end Ring

section Field

variable {K : Type} [Field K]

/-- **The constraint challenge.** Values that are not all zero fold to zero
for at most a fraction `(count - 1) / |K|` of the challenges. -/
theorem fractionLE_foldAlpha [Fintype K] (vals : Array K) (h : ∃ i, vals.getD i 0 ≠ 0) :
    FractionLE (fun α : K => foldAlpha α vals = 0) ((vals.size - 1 : ℕ) / Fintype.card K) := by
  obtain ⟨i, hi⟩ := h
  have hlt : i < vals.size := by
    by_contra hlt
    refine hi ?_
    rw [Array.getD_eq_getD_getElem?, Array.getElem?_eq_none (Nat.le_of_not_lt hlt)]
    rfl
  -- The fold is the value at `α` of a polynomial with the coefficients `vals`.
  obtain ⟨p, hp⟩ : ∃ p : K[X], p = ∑ j ∈ Finset.range vals.size,
      C (vals.getD j 0) * X ^ (vals.size - 1 - j) := ⟨_, rfl⟩
  have heval : ∀ α : K, p.eval α = foldAlpha α vals := by
    intro α
    rw [foldAlpha_eq_sum, hp, eval_finsetSum]
    exact Finset.sum_congr rfl fun j _ => by rw [eval_mul, eval_C, eval_pow, eval_X]
  have hcoeff : p.coeff (vals.size - 1 - i) = vals.getD i 0 := by
    rw [hp, finsetSum_coeff, Finset.sum_eq_single i]
    · rw [coeff_C_mul_X_pow, ite_eq_left rfl]
    · intro j hj hji
      have hj' := Finset.mem_range.mp hj
      rw [coeff_C_mul_X_pow, ite_eq_right (by omega)]
    · intro hmem
      exact absurd (Finset.mem_range.mpr hlt) hmem
  have hne : p ≠ 0 := by
    intro h0
    rw [h0, coeff_zero] at hcoeff
    exact hi hcoeff.symm
  have hdeg : p.natDegree ≤ vals.size - 1 := by
    rw [hp]
    refine natDegree_sum_le_of_forall_le _ _ fun j _ => ?_
    exact (natDegree_C_mul_X_pow_le _ _).trans (Nat.sub_le _ _)
  refine ((fractionLE_eval_eq_zero hne).mono_left fun α hα => ?_).mono_right ?_
  · rw [heval]
    exact hα
  · exact div_le_div_of_nonneg_right (Nat.cast_le.mpr hdeg) (Nat.cast_nonneg _)

/-! ## The columns of a circuit -/

/-- The columns of one circuit, as polynomials: the fixed trace, the main
trace, the lookup trace (in coordinates) and the chunks of the quotient (in
coordinates), each by position. -/
structure Columns (K : Type) [Field K] where
  /-- The columns of the fixed trace. -/
  pre : ℕ → K[X]
  /-- The columns of the main trace. -/
  main : ℕ → K[X]
  /-- The columns of the lookup trace. -/
  stage2 : ℕ → K[X]
  /-- The columns of the quotient: coordinate `j` of chunk `i` is at position
  `i * d + j`. -/
  quotient : ℕ → K[X]

/-- The row of polynomials the constraints of a circuit are evaluated on, for a
trace domain of order `n` generated by `g`: each column, the column shifted to
the next row, the public values as constants, and the selectors. -/
noncomputable def polyRow (c : Circuit F) (n : ℕ) (g : K) (cols : Columns K)
    (publics : Array K) : RowValues K[X] where
  preprocessed := Array.ofFn (n := c.preprocessedWidth) fun j => cols.pre j.val
  preprocessedNext := Array.ofFn (n := c.preprocessedWidth) fun j =>
    (cols.pre j.val).comp (C g * X)
  main := Array.ofFn (n := c.mainWidth) fun j => cols.main j.val
  mainNext := Array.ofFn (n := c.mainWidth) fun j => (cols.main j.val).comp (C g * X)
  stage2 := Array.ofFn (n := c.stage2Width) fun j => cols.stage2 j.val
  stage2Next := Array.ofFn (n := c.stage2Width) fun j => (cols.stage2 j.val).comp (C g * X)
  publics := publics.map C
  isFirstRow := ∑ i ∈ Finset.range n, X ^ i
  isLastRow := C g * ∑ i ∈ Finset.range n, (C g * X) ^ i
  isTransition := X - C g⁻¹

/-- The values of the row of a circuit at the point `x`: each column at `x` and
at `x * g`, the public values, and the selectors at `x`. -/
noncomputable def pointRow (c : Circuit F) (n : ℕ) (g : K) (cols : Columns K)
    (publics : Array K) (x : K) : RowValues K where
  preprocessed := Array.ofFn (n := c.preprocessedWidth) fun j => (cols.pre j.val).eval x
  preprocessedNext := Array.ofFn (n := c.preprocessedWidth) fun j =>
    (cols.pre j.val).eval (x * g)
  main := Array.ofFn (n := c.mainWidth) fun j => (cols.main j.val).eval x
  mainNext := Array.ofFn (n := c.mainWidth) fun j => (cols.main j.val).eval (x * g)
  stage2 := Array.ofFn (n := c.stage2Width) fun j => (cols.stage2 j.val).eval x
  stage2Next := Array.ofFn (n := c.stage2Width) fun j => (cols.stage2 j.val).eval (x * g)
  publics := publics
  isFirstRow := ∑ i ∈ Finset.range n, x ^ i
  isLastRow := g * ∑ i ∈ Finset.range n, (g * x) ^ i
  isTransition := x - g⁻¹

/-- Evaluating the row of polynomials at `x` gives the row of values at `x`. -/
theorem mapRow_eval_polyRow (c : Circuit F) (n : ℕ) (g : K) (cols : Columns K)
    (publics : Array K) (x : K) :
    mapRow (evalRingHom x) (polyRow c n g cols publics) = pointRow c n g cols publics x := by
  simp only [mapRow, polyRow, pointRow, Array.map_ofFn, Array.map_map, Function.comp_def,
    coe_evalRingHom, eval_comp, eval_mul, eval_C, eval_X, eval_finsetSum, eval_pow, eval_sub,
    mul_comm g x, Array.map_id']

/-! ## The selectors -/

/-- The first-row selector outside the domain, as the verifier computes it. -/
theorem selector_first {n : ℕ} {x : K} (hx : x ≠ 1) :
    ∑ i ∈ Finset.range n, x ^ i = (x ^ n - 1) * (x - 1)⁻¹ := by
  rw [geom_sum_eq hx, div_eq_mul_inv]

/-- The last-row selector outside the domain, as the verifier computes it. -/
theorem selector_last {n : ℕ} {g x : K} (hg : g ^ n = 1) (hg0 : g ≠ 0) (hx : x ≠ g⁻¹) :
    g * ∑ i ∈ Finset.range n, (g * x) ^ i = (x ^ n - 1) * (x - g⁻¹)⁻¹ := by
  have hgx : g * x ≠ 1 := fun h => hx (eq_inv_of_mul_eq_one_right h)
  have h1 : x - g⁻¹ ≠ 0 := sub_ne_zero.mpr hx
  have h2 : g * x - 1 ≠ 0 := sub_ne_zero.mpr hgx
  rw [geom_sum_eq hgx, mul_pow, hg, one_mul]
  field_simp

/-- The first-row selector on row `r` of the domain: `n` on the first row and
zero elsewhere. -/
theorem selector_first_pow {n : ℕ} {g : K} (hg : IsPrimitiveRoot g n) {r : ℕ} (hr : r < n) :
    ∑ i ∈ Finset.range n, (g ^ r) ^ i = if r = 0 then (n : K) else 0 := by
  split
  · next h =>
    rw [h, pow_zero]
    simp only [one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
  · next h =>
    have hne : g ^ r ≠ 1 := hg.pow_ne_one_of_pos_of_lt h hr
    rw [geom_sum_eq hne, ← pow_mul, mul_comm, pow_mul, hg.pow_eq_one, one_pow, sub_self, zero_div]

/-- The last-row selector on row `r` of the domain: `n * g` on the last row
and zero elsewhere. -/
theorem selector_last_pow {n : ℕ} {g : K} (hg : IsPrimitiveRoot g n) {r : ℕ} (hr : r < n) :
    g * ∑ i ∈ Finset.range n, (g * g ^ r) ^ i = if r + 1 = n then (n : K) * g else 0 := by
  rw [← pow_succ']
  split
  · next h =>
    rw [h, hg.pow_eq_one, mul_comm]
    simp only [one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
  · next h =>
    rw [selector_first_pow hg (by omega), ite_eq_right (Nat.succ_ne_zero r), mul_zero]

/-! ## The folded constraints and the quotient -/

/-- The constraints of a circuit folded with `α`, as a polynomial. -/
noncomputable def compPoly (ι : F → K) (d : ℕ) (T : Array K) (c : Circuit F) (n : ℕ) (g : K)
    (cols : Columns K) (publics deltaScaled : Array K) (α : K) : K[X] :=
  foldAlpha (C α) (constraintVals (fun a => C (ι a)) d (T.map C) c (polyRow c n g cols publics)
    (deltaScaled.map C))

/-- The folded constraints at a point are the fold of the constraint values of
the row at that point. -/
theorem eval_compPoly (ι : F → K) (d : ℕ) (T : Array K) (c : Circuit F) (n : ℕ) (g : K)
    (cols : Columns K) (publics deltaScaled : Array K) (α x : K) :
    (compPoly ι d T c n g cols publics deltaScaled α).eval x =
      foldAlpha α (constraintVals ι d T c (pointRow c n g cols publics x) deltaScaled) := by
  rw [compPoly, ← coe_evalRingHom, map_foldAlpha, map_constraintVals, mapRow_eval_polyRow]
  simp only [coe_evalRingHom, eval_C, Array.map_map, Function.comp_def, Array.map_id']

/-- The quotient, reassembled from its chunks: `∑ i, X^(n * i) * chunk_i`,
where chunk `i` is the polynomial with the coordinates `quotient (i * d + j)`
in the basis `e`. -/
noncomputable def quotientPoly (e : ℕ → K) (d n chunks : ℕ) (cols : Columns K) : K[X] :=
  ∑ i ∈ Finset.range chunks, X ^ (n * i) *
    ∑ j ∈ Finset.range d, C (e j) * cols.quotient (i * d + j)

/-- The quotient at a point, as the verifier reassembles it. -/
theorem eval_quotientPoly (e : ℕ → K) (d n chunks : ℕ) (cols : Columns K) (x : K) :
    (quotientPoly e d n chunks cols).eval x =
      ∑ i ∈ Finset.range chunks, (x ^ n) ^ i *
        ∑ j ∈ Finset.range d, (cols.quotient (i * d + j)).eval x * e j := by
  simp only [quotientPoly, eval_finsetSum, eval_mul, eval_pow, eval_X, eval_C, pow_mul]
  refine Finset.sum_congr rfl fun i _ => ?_
  congr 1
  exact Finset.sum_congr rfl fun j _ => mul_comm _ _

/-- A bound on the degree of the polynomial the check at `ζ` is about, for a
trace domain of order `n` and columns of degree at most `dcol`. -/
def _root_.CertiFri.Stark.Circuit.zetaDegree (c : Circuit F) (n dcol : ℕ) : ℕ :=
  max ((max c.lookupGroupSize 1 + 1)
      * max (maxNodeDeg dcol (n - 1) c.graph.nodes) (max dcol (n - 1)))
    (n * c.quotientDegree + dcol)

/-- The columns have degree at most `dcol`. -/
structure Columns.DegLE (cols : Columns K) (dcol : ℕ) : Prop where
  /-- The fixed trace. -/
  pre : ∀ j, (cols.pre j).natDegree ≤ dcol
  /-- The main trace. -/
  main : ∀ j, (cols.main j).natDegree ≤ dcol
  /-- The lookup trace. -/
  stage2 : ∀ j, (cols.stage2 j).natDegree ≤ dcol
  /-- The quotient. -/
  quotient : ∀ j, (cols.quotient j).natDegree ≤ dcol

/-- A read of an array given by a function: the value of the function inside
the array, zero outside. -/
private theorem getD_ofFn {α : Type} [Zero α] {w : ℕ} (f : Fin w → α) (i : ℕ) :
    (Array.ofFn f).getD i 0 = if h : i < w then f ⟨i, h⟩ else 0 := by
  rw [Array.getD_eq_getD_getElem?, Array.getElem?_ofFn]
  split <;> rfl

/-- A read of an array of polynomials of degree at most `dcol` has degree at
most `dcol`. -/
private theorem natDegree_getD_ofFn_le {w dcol : ℕ} {p : Fin w → K[X]}
    (hp : ∀ j, (p j).natDegree ≤ dcol) (i : ℕ) : ((Array.ofFn p).getD i 0).natDegree ≤ dcol := by
  rw [getD_ofFn]
  split
  · exact hp _
  · rw [natDegree_zero]
    exact Nat.zero_le _

/-- A read of an array of constants is a constant. -/
private theorem natDegree_getD_map_C (a : Array K) (i : ℕ) :
    ((a.map C).getD i 0).natDegree = 0 := by
  rw [Array.getD_eq_getD_getElem?, Array.getElem?_map]
  cases a[i]? with
  | none => exact natDegree_zero
  | some x => exact natDegree_C x

/-- `C g * X` has degree at most one. -/
private theorem natDegree_C_mul_X_le_one (g : K) : (C g * X : K[X]).natDegree ≤ 1 :=
  (natDegree_C_mul_le g X).trans natDegree_X_le

/-- A column shifted to the next row keeps its degree bound. -/
private theorem natDegree_comp_C_mul_X_le (g : K) {p : K[X]} {dcol : ℕ}
    (hp : p.natDegree ≤ dcol) : (p.comp (C g * X)).natDegree ≤ dcol :=
  natDegree_comp_le.trans
    ((Nat.mul_le_mul hp (natDegree_C_mul_X_le_one g)).trans (Nat.mul_one dcol).le)

/-- The row of polynomials of columns of degree at most `dcol`: the selectors
of the first and of the last row have degree at most `n - 1`. -/
private theorem rowDegLE_polyRow (c : Circuit F) (n : ℕ) (g : K) {cols : Columns K} {dcol : ℕ}
    (hcols : cols.DegLE dcol) (publics : Array K) :
    RowDegLE (polyRow c n g cols publics) dcol (n - 1) where
  preprocessed := natDegree_getD_ofFn_le fun j => hcols.pre j.val
  preprocessedNext :=
    natDegree_getD_ofFn_le fun j => natDegree_comp_C_mul_X_le g (hcols.pre j.val)
  main := natDegree_getD_ofFn_le fun j => hcols.main j.val
  mainNext := natDegree_getD_ofFn_le fun j => natDegree_comp_C_mul_X_le g (hcols.main j.val)
  stage2 := natDegree_getD_ofFn_le fun j => hcols.stage2 j.val
  stage2Next :=
    natDegree_getD_ofFn_le fun j => natDegree_comp_C_mul_X_le g (hcols.stage2 j.val)
  publics := natDegree_getD_map_C publics
  isFirstRow :=
    natDegree_sum_le_of_forall_le _ _ fun i hi =>
      (natDegree_X_pow_le i).trans (Nat.le_sub_one_of_lt (Finset.mem_range.mp hi))
  isLastRow := by
    refine (natDegree_C_mul_le _ _).trans (natDegree_sum_le_of_forall_le _ _ fun i hi => ?_)
    refine natDegree_pow_le.trans ((Nat.mul_le_mul_left i (natDegree_C_mul_X_le_one g)).trans ?_)
    rw [Nat.mul_one]
    exact Nat.le_sub_one_of_lt (Finset.mem_range.mp hi)
  isTransition := natDegree_X_sub_C_le g⁻¹

/-- Folding polynomials with a constant does not raise the degree. -/
private theorem natDegree_foldAlpha_le (α : K) (vals : Array K[X]) {B : ℕ}
    (h : ∀ i, (vals.getD i 0).natDegree ≤ B) : (foldAlpha (C α) vals).natDegree ≤ B := by
  rw [foldAlpha_eq_sum]
  refine natDegree_sum_le_of_forall_le _ _ fun i _ => ?_
  rw [← C_pow, mul_comm]
  exact (natDegree_C_mul_le _ _).trans (h i)

/-- The degree of every constraint of a circuit on the row of polynomials. -/
private theorem natDegree_constraintVals_le (ι : F → K) (d : ℕ) (T : Array K) (c : Circuit F)
    (n : ℕ) (g : K) {cols : Columns K} {dcol : ℕ} (hcols : cols.DegLE dcol)
    (publics deltaScaled : Array K) (i : ℕ) :
    ((constraintVals (fun a => C (ι a)) d (T.map C) c (polyRow c n g cols publics)
        (deltaScaled.map C)).getD i 0).natDegree ≤
      (max c.lookupGroupSize 1 + 1)
        * max (maxNodeDeg dcol (n - 1) c.graph.nodes) (max dcol (n - 1)) := by
  have hrow := rowDegLE_polyRow c n g hcols publics
  have hbuf : ∀ k, ((sweep (fun a => C (ι a)) c.graph.nodes
      (polyRow c n g cols publics)).getD k 0).natDegree ≤ maxNodeDeg dcol (n - 1) c.graph.nodes :=
    natDegree_sweep_le_max _ (fun a => natDegree_C (ι a)) _ hrow
  have hcol : dcol ≤ max (maxNodeDeg dcol (n - 1) c.graph.nodes) (max dcol (n - 1)) :=
    (le_max_left _ _).trans (le_max_right _ _)
  by_cases hi : i < c.graph.zeros.size
  · rw [getD_constraintVals_zero _ _ _ _ _ _ hi]
    exact (hbuf _).trans ((le_max_left _ _).trans (Nat.le_mul_of_pos_left _ (Nat.succ_pos _)))
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (Nat.le_of_not_lt hi)
    rw [getD_constraintVals_logup]
    exact natDegree_logupValues_le d _ _ _ _ _ _ _ _ _ _ (natDegree_getD_map_C T)
      (natDegree_getD_map_C publics) (natDegree_getD_map_C deltaScaled)
      (fun j => (hbuf j).trans (le_max_left _ _)) (fun j => (hrow.stage2 j).trans hcol)
      (fun j => (hrow.stage2Next j).trans hcol)
      (hrow.isLastRow.trans ((le_max_right _ _).trans (le_max_right _ _))) k

/-- The vanishing polynomial of the domain times the quotient has degree at
most `n * chunks + dcol`. -/
private theorem natDegree_vanishing_mul_quotientPoly_le (e : ℕ → K) (d n chunks : ℕ)
    {cols : Columns K} {dcol : ℕ} (hcols : cols.DegLE dcol) :
    ((X ^ n - 1) * quotientPoly e d n chunks cols).natDegree ≤ n * chunks + dcol := by
  rcases Nat.eq_zero_or_pos chunks with rfl | hpos
  · rw [quotientPoly, Finset.range_zero, Finset.sum_empty, mul_zero, natDegree_zero]
    exact Nat.zero_le _
  · have hq : (quotientPoly e d n chunks cols).natDegree ≤ n * (chunks - 1) + dcol := by
      refine natDegree_sum_le_of_forall_le _ _ fun i hi => ?_
      refine natDegree_mul_le.trans (Nat.add_le_add ?_ ?_)
      · exact (natDegree_X_pow_le _).trans
          (Nat.mul_le_mul_left n (Nat.le_sub_one_of_lt (Finset.mem_range.mp hi)))
      · exact natDegree_sum_le_of_forall_le _ _ fun j _ =>
          (natDegree_C_mul_le _ _).trans (hcols.quotient _)
    have hv : (X ^ n - 1 : K[X]).natDegree ≤ n :=
      (natDegree_sub_le _ _).trans
        (max_le (natDegree_X_pow_le n) (natDegree_one.le.trans (Nat.zero_le n)))
    refine natDegree_mul_le.trans ((Nat.add_le_add hv hq).trans ?_)
    obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hpos.ne'
    rw [Nat.succ_sub_one, Nat.mul_succ]
    omega

/-- The degree of the polynomial the check at `ζ` is about. -/
theorem natDegree_compPoly_sub_le (ι : F → K) (e : ℕ → K) (d : ℕ) (T : Array K) (c : Circuit F)
    {n : ℕ} (g : K) {cols : Columns K} {dcol : ℕ} (hcols : cols.DegLE dcol)
    (publics deltaScaled : Array K) (α : K) :
    (compPoly ι d T c n g cols publics deltaScaled α
        - (X ^ n - 1) * quotientPoly e d n c.quotientDegree cols).natDegree
      ≤ c.zetaDegree n dcol := by
  refine (natDegree_sub_le _ _).trans (max_le_max ?_ ?_)
  · exact natDegree_foldAlpha_le α _
      (natDegree_constraintVals_le ι d T c n g hcols publics deltaScaled)
  · exact natDegree_vanishing_mul_quotientPoly_le e d n c.quotientDegree hcols

/-- **The out-of-domain point.** If the folded constraints do not vanish at
some point of the trace domain, then for at most a fraction
`zetaDegree / |K|` of the points `ζ` the folded constraints at `ζ` are the
vanishing polynomial of the domain times the quotient at `ζ`. -/
theorem fractionLE_zeta [Fintype K] (ι : F → K) (e : ℕ → K) (d : ℕ) (T : Array K)
    (c : Circuit F) {n : ℕ} (g : K) {cols : Columns K} {dcol : ℕ}
    (hcols : cols.DegLE dcol) (publics deltaScaled : Array K) (α : K)
    (hx : ∃ x : K, x ^ n = 1 ∧ (compPoly ι d T c n g cols publics deltaScaled α).eval x ≠ 0) :
    FractionLE (fun ζ : K => (compPoly ι d T c n g cols publics deltaScaled α).eval ζ =
        (ζ ^ n - 1) * (quotientPoly e d n c.quotientDegree cols).eval ζ)
      (c.zetaDegree n dcol / Fintype.card K) := by
  obtain ⟨x, hxn, hx⟩ := hx
  have hp : compPoly ι d T c n g cols publics deltaScaled α
      - (X ^ n - 1) * quotientPoly e d n c.quotientDegree cols ≠ 0 := by
    intro h0
    have h := congrArg (eval x) h0
    rw [eval_sub, eval_mul, eval_sub, eval_pow, eval_X, eval_one, hxn, sub_self, zero_mul,
      sub_zero, eval_zero] at h
    exact hx h
  refine ((fractionLE_eval_eq_zero hp).mono_left fun ζ hζ => ?_).mono_right ?_
  · rw [eval_sub, eval_mul, eval_sub, eval_pow, eval_X, eval_one, hζ, sub_self]
  · exact div_le_div_of_nonneg_right
      (Nat.cast_le.mpr (natDegree_compPoly_sub_le ι e d T c g hcols publics deltaScaled α))
      (Nat.cast_nonneg _)

/-! ## The lookup sum of a circuit -/

/-- The messages a circuit sends on rows: for each of the `n` rows and each
lookup, the value of the multiplicity and the values of the arguments, where
`rows r` are the values of row `r`. -/
def circuitItems (ι : F → K) (c : Circuit F) (rows : ℕ → RowValues K) (n : ℕ) :
    List (K × List K) :=
  (List.range n).flatMap fun r =>
    c.graph.lookups.toList.map fun l =>
      ((sweep ι c.graph.nodes (rows r)).getD l.multiplicity 0,
        l.args.toList.map fun a => (sweep ι c.graph.nodes (rows r)).getD a 0)

/-- The coordinates of the difference between the lookup sums leaving and
entering a circuit, divided by the value `n * g` of the last-row selector on
the last row. The coordinates of the entering sum are the entries
`2 * d, …, 3 * d - 1` of the public values and those of the leaving sum the
entries `3 * d, …, 4 * d - 1`. -/
def deltaScaled (d n : ℕ) (g : K) (publics : Array K) : Array K :=
  Array.ofFn (n := d) fun j =>
    (publics.getD (3 * d + j.val) 0 - publics.getD (2 * d + j.val) 0) * ((n : K) * g)⁻¹

/-- A read of a segment of an array is a read of the array. -/
private theorem getD_extract (a : Array K) {i j k : ℕ} (hk : i + k < j) :
    (a.extract i j).getD k 0 = a.getD (i + k) 0 := by
  rw [Array.getD_eq_getD_getElem?, Array.getD_eq_getD_getElem?, Array.getElem?_extract]
  split
  · rfl
  · next h => rw [Array.getElem?_eq_none (by omega)]

/-- The scaled difference assembles to the difference of the lookup sums
leaving and entering the circuit, divided by `n * g`. -/
private theorem asm_deltaScaled (e : ℕ → K) (d n : ℕ) (g : K) (publics : Array K) :
    asm e d (deltaScaled d n g publics) =
      (asm e d (publics.extract (3 * d) (4 * d)) - asm e d (publics.extract (2 * d) (3 * d)))
        * ((n : K) * g)⁻¹ := by
  rw [asm, asm, asm, ← Finset.sum_sub_distrib, Finset.sum_mul]
  refine Finset.sum_congr rfl fun k hk => ?_
  have hk' := Finset.mem_range.mp hk
  rw [deltaScaled, getD_ofFn, dite_eq_left hk', getD_extract _ (by omega),
    getD_extract _ (by omega)]
  ring

/-- The sum of the images of the entries of a list, as a sum over positions. -/
private theorem sum_map_eq_sum_range {α : Type} (f : α → K) (dflt : α) (l : List α) :
    (l.map f).sum = ∑ j ∈ Finset.range l.length, f (l.getD j dflt) := by
  induction l with
  | nil => rfl
  | cons x l ih =>
    rw [List.map_cons, List.sum_cons, ih, List.length_cons, Finset.sum_range_succ', add_comm]
    rfl

/-- The message of a lookup is `β` plus the fingerprint of its arguments at
`γ`. -/
private theorem messageVal_eq_fpPoly (β γ : K) (buf : Array K) (l : Lookup) :
    messageVal β γ buf l = β + (fpPoly (l.args.toList.map fun a => buf.getD a 0)).eval γ := by
  rw [messageVal, eval_fpPoly_eq_sum, List.length_map, Array.length_toList]
  congr 1
  refine Finset.sum_congr rfl fun i hi => ?_
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, Array.getElem?_toList,
    Array.getD_eq_getD_getElem? (xs := l.args),
    Array.getElem?_eq_getElem (Finset.mem_range.mp hi)]
  rfl

/-- The lookup sum of the messages of one row, as a sum over the lookups. -/
private theorem lookupSum_row (β γ : K) (lookups : Array Lookup) (buf : Array K) :
    lookupSum β γ (lookups.toList.map fun l =>
        (buf.getD l.multiplicity 0, l.args.toList.map fun a => buf.getD a 0)) =
      ∑ j ∈ Finset.range lookups.size,
        buf.getD (lookups.getD j default).multiplicity 0 /
          messageVal β γ buf (lookups.getD j default) := by
  rw [lookupSum, List.map_map, sum_map_eq_sum_range _ default, Array.length_toList]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [messageVal_eq_fpPoly, List.getD_eq_getElem?_getD, Array.getElem?_toList,
    ← Array.getD_eq_getD_getElem?]
  rfl

/-- The lookup sum of the messages of `n` rows is the sum of the lookup sums of
the rows. -/
private theorem lookupSum_flatMap_range (β γ : K) (f : ℕ → List (K × List K)) (n : ℕ) :
    lookupSum β γ ((List.range n).flatMap f) = ∑ r ∈ Finset.range n, lookupSum β γ (f r) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [List.range_succ, List.flatMap_append, lookupSum_append, ih, Finset.sum_range_succ,
      List.flatMap_singleton]

/-- **The lookup sum of a circuit.** Let the lookup constraints of a circuit
vanish on every row of its trace domain, and no message of a row be zero for
the challenges `β` and `γ` of the public values. Then the lookup sum leaving
the circuit is the one entering it plus the lookup sum of the messages the
circuit sends on its rows.

`β`, `γ` and the two sums are the elements that the four groups of `d` public
values assemble to in the basis `e`. -/
theorem logup_circuit_eq {e : ℕ → K} {d : ℕ} {T : Array K} (hT : IsTable e d T) (h0 : e 0 = 1)
    (hd : 0 < d) (ι : F → K) (c : Circuit F) {n : ℕ} {g : K} (hg : IsPrimitiveRoot g n)
    (hn : (n : K) ≠ 0) (cols : Columns K) (publics : Array K)
    (hzero : ∀ r < n, ∀ i,
      (logupValues d T c.graph.lookups
        (sweep ι c.graph.nodes (pointRow c n g cols publics (g ^ r)))
        (pointRow c n g cols publics (g ^ r)).stage2
        (pointRow c n g cols publics (g ^ r)).stage2Next publics (deltaScaled d n g publics)
        (pointRow c n g cols publics (g ^ r)).isLastRow c.lookupGroupSize).getD i 0 = 0)
    (hne : ∀ it ∈ circuitItems ι c (fun r => pointRow c n g cols publics (g ^ r)) n,
      asm e d (publics.extract 0 d)
        + (fpPoly it.2).eval (asm e d (publics.extract d (2 * d))) ≠ 0) :
    asm e d (publics.extract (3 * d) (4 * d)) - asm e d (publics.extract (2 * d) (3 * d)) =
      lookupSum (asm e d (publics.extract 0 d)) (asm e d (publics.extract d (2 * d)))
        (circuitItems ι c (fun r => pointRow c n g cols publics (g ^ r)) n) := by
  have hn0 : n ≠ 0 := fun h => hn (by rw [h, Nat.cast_zero])
  have hng : (n : K) * g ≠ 0 := mul_ne_zero hn (hg.ne_zero hn0)
  -- The constraints of row `r`: the lookup sum grows by the lookup sum of the
  -- messages of the row, with the scaled difference on the last row.
  have hrow : ∀ r ∈ Finset.range n,
      asm e d (pointRow c n g cols publics (g ^ (r + 1))).stage2
          - asm e d (pointRow c n g cols publics (g ^ r)).stage2
          + (if r + 1 = n then (n : K) * g else 0) * asm e d (deltaScaled d n g publics) =
        lookupSum (asm e d (publics.extract 0 d)) (asm e d (publics.extract d (2 * d)))
          (c.graph.lookups.toList.map fun l =>
            ((sweep ι c.graph.nodes (pointRow c n g cols publics (g ^ r))).getD l.multiplicity 0,
              l.args.toList.map fun a =>
                (sweep ι c.graph.nodes (pointRow c n g cols publics (g ^ r))).getD a 0)) := by
    intro r hr
    have hr' := Finset.mem_range.mp hr
    have hnext : (pointRow c n g cols publics (g ^ r)).stage2Next =
        (pointRow c n g cols publics (g ^ (r + 1))).stage2 := by
      rw [pow_succ]
      rfl
    have hlast : (pointRow c n g cols publics (g ^ r)).isLastRow =
        if r + 1 = n then (n : K) * g else 0 := selector_last_pow hg hr'
    have h := logup_row_eq hT h0 hd c.graph.lookups
      (sweep ι c.graph.nodes (pointRow c n g cols publics (g ^ r)))
      (pointRow c n g cols publics (g ^ r)).stage2
      (pointRow c n g cols publics (g ^ r)).stage2Next publics (deltaScaled d n g publics)
      (pointRow c n g cols publics (g ^ r)).isLastRow c.lookupGroupSize (hzero r hr') ?_
    · rw [hnext, hlast] at h
      rw [lookupSum_row, ← h]
      ring
    · intro j hj
      rw [messageVal_eq_fpPoly]
      refine hne (_, _) (List.mem_flatMap.mpr ⟨r, List.mem_range.mpr hr',
        List.mem_map.mpr ⟨c.graph.lookups.getD j default, ?_, rfl⟩⟩)
      rw [Array.getD_eq_getD_getElem?, Array.getElem?_eq_getElem hj, Option.getD_some]
      exact Array.getElem_mem_toList hj
  -- Over the rows the lookup sums cancel: the row after the last is the first.
  rw [circuitItems, lookupSum_flatMap_range, ← Finset.sum_congr rfl hrow, Finset.sum_add_distrib,
    Finset.sum_range_sub (fun r => asm e d (pointRow c n g cols publics (g ^ r)).stage2),
    hg.pow_eq_one, pow_zero, sub_self, zero_add, ← Finset.sum_mul,
    Finset.sum_eq_single (n - 1), ite_eq_left (Nat.sub_add_cancel (Nat.pos_of_ne_zero hn0)),
    asm_deltaScaled]
  · rw [mul_left_comm ((n : K) * g), mul_inv_cancel₀ hng, mul_one]
  · intro r hr hrn
    have hr' := Finset.mem_range.mp hr
    exact ite_eq_right (by omega)
  · intro hmem
    exact absurd (Finset.mem_range.mpr (Nat.sub_lt (Nat.pos_of_ne_zero hn0) Nat.one_pos)) hmem

